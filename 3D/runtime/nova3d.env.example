# Copy this file to nova3d.env and fill in your real token before running live Nova3D validation.
NOVA3D_TOKEN=n3d_your_real_token_here
NOVA3D_API_URL=https://nova3d.xyz/api
THREED_NOVA3D_PROMPT=a simple cabinet with a body and a door
THREED_NOVA3D_MODEL=gemini
THREED_SESSION_ID=session_live_runner

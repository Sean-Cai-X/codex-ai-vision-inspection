Image m_image;
FastMatch m_match;
m_image.copyFromMat(global_matInput);
m_match.setrectxywh(60,50,200,140);
m_match.setobjfilter(1);
m_match.setwhgap(8,8);
m_match.setthre(20);
m_match.setlinegap(2);
m_match.setcompgap(3);
m_match.setnormaltraceenabled(1);
m_match.setformfitenabled(1);
m_match.setformfitbudget(1,64,1000);
m_match.setmatchrectxywh(60,50,200,140);
m_match.matchstepgap(2,2);
m_match.setmatchthre(10);
m_match.setminscore(0.5);
m_match.setfindnum(1);
m_match.setlearnwgap(0,8);
m_match.setlearnhgap(0,8);
m_match.setlearnmethod(0,1);
m_match.setlearnthre(0,20);
m_match.setlearnlinegap(0,2);
m_match.setlearnobjfilter(0,1);
m_match.setlearncompgap(0,3);
m_match.setlearnedgecount(0,2);
m_match.setlearnselectededge(0,1);
m_match.setlearnwgap(1,8);
m_match.setlearnhgap(1,8);
m_match.setlearnmethod(1,0);
m_match.setlearnthre(1,20);
m_match.setlearnlinegap(1,2);
m_match.setlearnobjfilter(1,1);
m_match.setlearncompgap(1,3);
m_match.setlearnedgecount(1,2);
m_match.setlearnselectededge(1,1);
m_match.setlearnwgap(2,8);
m_match.setlearnhgap(2,8);
m_match.setlearnmethod(2,1);
m_match.setlearnthre(2,20);
m_match.setlearnlinegap(2,2);
m_match.setlearnobjfilter(2,1);
m_match.setlearncompgap(2,3);
m_match.setlearnedgecount(2,2);
m_match.setlearnselectededge(2,1);
m_match.setlearnwgap(3,8);
m_match.setlearnhgap(3,8);
m_match.setlearnmethod(3,0);
m_match.setlearnthre(3,20);
m_match.setlearnlinegap(3,2);
m_match.setlearnobjfilter(3,1);
m_match.setlearncompgap(3,3);
m_match.setlearnedgecount(3,2);
m_match.setlearnselectededge(3,1);
m_match.learn(m_image);
m_match.modelzero();
m_match.pattern2org();
m_match.samplemodel(100);
m_match.match(m_image);
global_match_count = m_match.getresultcandidatecount();
global_candidate_count = global_match_count;
global_best_score = m_match.getresultbestscore();
HarmonicAudit audit;
audit.snapshotfastmatch(m_match);
m_match.setformfitenabled(0);
audit.expectunchanged(m_match);

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geometry set matching development receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cxvision.geometric_set_match.receipt.v1"
    },
    "mode": {
      "const": "DEVELOPMENT_FULL_SET"
    },
    "production_eligible": {
      "const": false
    },
    "image_extraction_performed": {
      "const": false
    },
    "input_bytes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effective_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "$ref": "geometric_set_match.schema.json#/$defs/request"
    },
    "result": {
      "$ref": "geometric_set_match.schema.json#/$defs/result"
    },
    "assertions_passed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "mode",
    "production_eligible",
    "image_extraction_performed",
    "input_bytes_sha256",
    "effective_request_sha256",
    "request",
    "result",
    "assertions_passed"
  ],
  "$comment": "Local receipt, not a signature or production approval. SHA identifies bytes/canonical effective request, not trust in input provenance. Geometry/source refs may themselves be sensitive; export only through business redaction policy. No image field is accepted."
}

{
  "schema": "cxvision.model_incremental_branch_contract.v1",
  "purpose": "asset-driven sparse model branching, candidate evaluation, human review, and promotion",
  "automatic_promotion_allowed": false,
  "global_latest_model_allowed": false,
  "case_name_dispatch_allowed": false,
  "immutable_model_nodes": true,
  "normal_candidate_parent_count": 1,
  "merge_requires_explicit_merge_candidate": true,
  "model_node_required_fields": [
    "schema",
    "model_id",
    "display_name",
    "node_kind",
    "root_release_id",
    "branch_id",
    "parent_model_ids",
    "task",
    "architecture_id",
    "capability_manifest_ref",
    "model_manifest_ref",
    "checkpoint_ref",
    "checkpoint_hash",
    "class_ontology_ref",
    "dataset_binding_ref",
    "training_plan_ref",
    "metric_bundle_ref",
    "promotion_status"
  ],
  "node_kinds": [
    "release",
    "incremental_candidate",
    "architecture_candidate",
    "merge_candidate",
    "retired_release"
  ],
  "increment_kinds": [
    "data_increment",
    "domain_increment",
    "class_increment",
    "geometry_capability_increment",
    "architecture_increment"
  ],
  "candidate_states": [
    "DISCOVERED",
    "ASSET_PREFLIGHT_PASS",
    "ASSET_PREFLIGHT_FAIL",
    "TRAINING_RUNNING",
    "TRAINING_COMPLETE",
    "EVALUATION_COMPLETE",
    "GATE_FAILED",
    "PENDING_HUMAN_REVIEW",
    "HUMAN_ACCEPTED",
    "HUMAN_REJECTED",
    "PROMOTED",
    "RETIRED"
  ],
  "required_dataset_roles": [
    "incremental_train",
    "incremental_validation",
    "parent_replay",
    "frozen_release_validation",
    "negative_and_hard_samples"
  ],
  "required_metric_groups": [
    "training_curves",
    "validation_curves",
    "new_domain_metrics",
    "parent_retention_metrics",
    "per_class_metrics",
    "geometry_metrics",
    "false_positive_metrics",
    "deployment_budget_metrics",
    "route_metrics",
    "canonical_boundary_metrics",
    "clamp_consistency_metrics"
  ],
  "required_computed_facts": [
    "new_domain_gain",
    "parent_retention_delta",
    "forgetting_delta",
    "worst_class_regression",
    "false_positive_delta",
    "latency_delta",
    "model_size_delta"
  ],
  "required_human_validation_records": [
    "parent_model_selection_review",
    "freeze_policy_review",
    "inference_difference_review"
  ],
  "parent_model_selection_required_facts": [
    "selected_parent_model_id",
    "selected_parent_display_name",
    "task",
    "output_contract",
    "capabilities",
    "class_ontology_version",
    "input_contract",
    "runtime_backend",
    "deployment_compatibility",
    "selection_reason",
    "human_decision"
  ],
  "freeze_policy_required_facts": [
    "freeze_policy_id",
    "frozen_parameter_groups",
    "trainable_parameter_groups",
    "checkpoint_transfer_report_ref",
    "parameter_hash_before_ref",
    "parameter_hash_after_ref",
    "per_group_gradient_report_ref",
    "per_group_update_report_ref",
    "replay_retention_report_ref",
    "human_decision"
  ],
  "inference_difference_required_facts": [
    "parent_result_ref",
    "candidate_result_ref",
    "same_input_proof",
    "same_metric_contract_proof",
    "difference_class",
    "root_cause_stage",
    "resolution_kind",
    "resolution_evidence_ref",
    "remaining_risk",
    "human_decision"
  ],
  "inference_difference_classes": [
    "EXPECTED_NEW_DOMAIN_GAIN",
    "PARENT_CAPABILITY_RETAINED",
    "HISTORICAL_REGRESSION",
    "FALSE_POSITIVE_EXPANSION",
    "CLASS_ONTOLOGY_MISMATCH",
    "PREPROCESS_MISMATCH",
    "COORDINATE_OR_GEOMETRY_MISMATCH",
    "POSTPROCESS_OR_THRESHOLD_MISMATCH",
    "MODEL_CAPABILITY_MISMATCH",
    "UNRESOLVED_DIFFERENCE"
  ],
  "allowed_resolution_kinds": [
    "NO_CHANGE_ACCEPTED_DIFFERENCE",
    "PREPROCESS_CONTRACT_FIX",
    "COORDINATE_CONTRACT_FIX",
    "THRESHOLD_CALIBRATION",
    "ONTOLOGY_MAPPING_FIX",
    "DATA_AND_LABEL_CORRECTION",
    "NEW_INCREMENTAL_CANDIDATE",
    "CAPABILITY_BRANCH_REQUIRED",
    "CANDIDATE_REJECTED"
  ],
  "gate_order": [
    "parent_model_resolved",
    "parent_model_selection_human_confirmed",
    "capability_compatible_or_explicit_capability_increment",
    "class_ontology_resolved",
    "incremental_dataset_accepted",
    "replay_dataset_bound",
    "training_complete",
    "freeze_policy_execution_verified",
    "new_domain_evaluation_complete",
    "parent_retention_evaluation_complete",
    "frozen_release_validation_complete",
    "deployment_budget_complete",
    "inference_differences_resolved_or_explicitly_accepted",
    "threshold_policy_evaluated",
    "scene_route_evaluation_complete",
    "canonical_boundary_adapter_complete",
    "clamp_consistency_evaluation_complete",
    "human_review_saved",
    "branch_promotion_decided"
  ],
  "promotion_invariants": [
    "parent_model_is_immutable",
    "candidate_has_distinct_output_directory",
    "candidate_checkpoint_hash_exists",
    "same_metric_contract_used_for_parent_and_candidate",
    "no_missing_required_dataset_role",
    "no_single_case_promotion",
    "source_disjoint_validation_complete",
    "clamp_consistency_is_primary_geometry_gate",
    "no_automatic_human_decision",
    "promotion_is_branch_scoped"
  ],
  "merge_invariants": [
    "at_least_two_parent_model_ids",
    "class_ontologies_are_mapped",
    "capabilities_are_compatible_or_explicitly_migrated",
    "all_parent_replay_sets_are_bound",
    "all_parent_frozen_validation_sets_pass",
    "weight_averaging_is_not_used_as_implicit_merge",
    "human_merge_decision_is_saved"
  ],
  "forbidden": [
    "overwrite_parent_checkpoint",
    "global_latest_checkpoint",
    "candidate_without_parent_lineage",
    "train_only_on_sparse_new_samples",
    "promotion_from_training_loss_only",
    "promotion_from_current_smoke_cases_only",
    "automatic_branch_merge",
    "case_name_based_model_routing",
    "hardcoded_branch_or_run_id_in_cpp"
  ]
}

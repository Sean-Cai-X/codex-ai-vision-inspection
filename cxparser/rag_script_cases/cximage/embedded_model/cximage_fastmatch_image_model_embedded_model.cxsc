kind=module
layer=embedded_model
module=cximage
case=fastmatch_image_model
mode=build-run
report=on
Flow.Begin("cximage.fastmatch_image_model");
Input.Image("source_image","synthetic.embedded_model.train_source");
Input.Model("image_model","imagemodel.FastMatch.basic");
Input.Roi("roi_model",20,18,32,24);
Input.Param("method",2);
Input.Param("threshold",13);
Action.Call("FastMatch.imagelearn");
Action.Call("FastMatch.imagematch");
Check.ScalarGe("image_model_score",0);
Check.ScalarGe("candidate_count",0);
Output.Emit("FastImageModelResult");
Output.Conclusion("fastmatch_image_model_status","pass_if_checks_ok");
Flow.End();

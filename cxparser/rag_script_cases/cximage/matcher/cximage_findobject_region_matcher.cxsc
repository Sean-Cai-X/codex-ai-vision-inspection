kind=module
layer=matcher
module=cximage
case=findobject_region
mode=build-run
report=on
Flow.Begin("cximage.findobject_region");
Input.Image("source_image","synthetic.matcher.region_object");
Input.Roi("roi_main",20,18,32,24);
Input.Param("search_type",1);
Input.Param("distance",2);
Input.Param("min_area",20);
Action.Call("FindObject.shapesetroi");
Action.Call("FindObject.measure");
Check.ScalarGe("result_count",0);
Check.FieldExists("top1_rect");
Check.FieldExists("top1_center");
Output.Emit("FindObjectResults");
Output.Conclusion("findobject_region_status","pass_if_checks_ok");
Flow.End();

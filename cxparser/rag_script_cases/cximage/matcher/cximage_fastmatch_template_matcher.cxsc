kind=module
layer=matcher
module=cximage
case=fastmatch_template
mode=build-run
report=on
Flow.Begin("cximage.fastmatch_template");
Input.Image("source_image","synthetic.matcher.template_search");
Input.Roi("roi_match",20,18,32,24);
Input.Model("template_model","template.basic.rect");
Input.Param("method",2);
Input.Param("threshold",13);
Input.Param("min_score",0.50);
Input.Param("find_num",3);
Action.Call("FastMatch.setmatchrect");
Action.Call("FastMatch.match");
Check.ScalarGe("match_candidate_count_value",1);
Check.ScalarGe("match_top_score_value",0.50);
Check.RectValid("top1_rect");
Output.Emit("FastMatchCandidates");
Output.Conclusion("fastmatch_template_status","pass_if_checks_ok");
Flow.End();

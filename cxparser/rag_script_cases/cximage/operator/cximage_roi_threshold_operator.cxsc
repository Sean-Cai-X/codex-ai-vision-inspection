kind=module
layer=operator
module=cximage
case=roi_threshold
mode=build-run
report=on
Flow.Begin("cximage.roi_threshold");
Input.Image("source_image","synthetic.operator.threshold.primary");
Input.Roi("roi_main",16,12,48,40);
Input.Param("threshold",128);
Action.Call("Image.setroi");
Action.Call("Image.roithre");
Check.StructExists("roi_bounds");
Check.ScalarGe("foreground_pixels",0);
Output.Emit("RoiBinaryImage");
Output.Conclusion("roi_threshold_status","pass_if_checks_ok");
Flow.End();

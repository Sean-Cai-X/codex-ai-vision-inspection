kind=module
layer=operator
module=cximage
case=roi_gray_count
mode=build-run
report=on
Flow.Begin("cximage.roi_gray_count");
Input.Image("source_image","synthetic.operator.gray_count.primary");
Input.Roi("roi_main",16,12,48,40);
Action.Call("Image.setroi");
Action.Call("Image.roigray");
Action.Call("Image.roicount");
Check.FieldExists("gray_mode");
Check.ScalarGt("pixel_count",0);
Output.Emit("RoiGrayImage");
Output.Emit("RoiPixelCount");
Output.Conclusion("roi_gray_count_status","pass_if_checks_ok");
Flow.End();

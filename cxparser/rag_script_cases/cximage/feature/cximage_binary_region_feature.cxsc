kind=module
layer=feature
module=cximage
case=binary_region
mode=build-run
report=on
Flow.Begin("cximage.binary_region");
Input.Image("source_image","synthetic.feature.binary_region");
Input.Roi("roi_main",16,12,48,40);
Action.Call("Image.setroi");
Action.Call("Image.roiedge");
Action.Call("Image.roicount");
Action.Call("Image.getposvaluex");
Action.Call("Image.getposvaluey");
Check.FieldExists("region_pattern_foreground_ratio");
Check.FieldExists("region_pattern_descriptor_dim");
Check.FieldExists("region_pattern_descriptor_mean");
Check.FieldExists("region_pattern_descriptor_std");
Check.ScalarGe("region_pattern_foreground_ratio",0);
Check.ScalarGe("region_pattern_descriptor_dim",0);
Output.Emit("RegionPatternFeatureRecord");
Output.Emit("region_pattern_foreground_ratio");
Output.Emit("region_pattern_descriptor_dim");
Output.Emit("region_pattern_descriptor_mean");
Output.Emit("region_pattern_descriptor_std");
Output.Conclusion("binary_region_status","pass_if_checks_ok");
Flow.End();

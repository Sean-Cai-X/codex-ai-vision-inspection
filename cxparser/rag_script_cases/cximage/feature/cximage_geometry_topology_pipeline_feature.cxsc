kind=module
layer=feature
module=cximage
case=geometry_topology_pipeline
mode=build-run
report=on
Flow.Begin("cximage.geometry_topology_pipeline.feature");
Input.Image("binary_mask","synthetic.mask.binary_region");
Input.Image("region_mask","synthetic.region.binary_region");
Check.FieldExists("fractal_partition");
Check.FieldExists("distance_field");
Check.FieldExists("skeleton_mask");
Check.FieldExists("centerline_paths");
Check.FieldExists("topology_repair_paths");
Output.Emit("GeometryTopologyPipelineResult");
Output.Emit("fractal_partition");
Output.Emit("distance_field");
Output.Emit("skeleton_mask");
Output.Emit("centerline_paths");
Output.Emit("topology_repair_paths");
Output.Conclusion("geometry_topology_pipeline_status","pass_if_checks_ok");
Flow.End();

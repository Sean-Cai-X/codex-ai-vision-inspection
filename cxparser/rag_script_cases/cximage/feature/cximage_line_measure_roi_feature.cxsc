kind=module
layer=feature
module=cximage
case=line_measure_roi
mode=build-run
report=on
Flow.Begin("cximage.line_measure_roi");
Input.Image("source_image","synthetic.line.primary");
Input.Roi("roi_line",12,18,72,20);
Input.Param("line_gap",4);
Input.Param("threshold",8);
Input.Param("method",1);
Action.Call("measure_line");
Check.ScalarGe("point_count_value",1);
Check.ScalarGe("line_chain_length_value",1);
Check.ScalarGe("fit_error_avg_value",0);
Output.Emit("LineMeasurementOutput");
Output.Conclusion("line_measure_roi_status","pass_if_checks_ok");
Flow.End();

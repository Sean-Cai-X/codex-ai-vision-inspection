kind=module
layer=feature
module=cximage
case=circle_measure_fit
mode=build-run
report=on
Flow.Begin("cximage.circle_measure_fit");
Input.Image("source_image","synthetic.circle.primary");
Input.Roi("roi_circle",18,16,36,36);
Input.Param("fit_mode","enhanced_fit");
Input.Param("fit_compare","true");
Action.Call("measure_circle");
Check.ScalarGt("circle_radius_value",0);
Check.ScalarGe("circle_avg_distance_value",0);
Check.ScalarGe("circle_sample_points_value",1);
Output.Emit("CircleMeasurementOutput");
Output.Conclusion("circle_measure_fit_status","pass_if_checks_ok");
Flow.End();

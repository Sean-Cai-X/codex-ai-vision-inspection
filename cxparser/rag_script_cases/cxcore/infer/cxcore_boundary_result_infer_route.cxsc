kind=module
layer=infer
module=cxcore
case=boundary_result_infer_route
mode=build-run
report=on
Flow.Begin("cxcore.boundary_result_infer_route");
Input.Image("source_image","infer.board_inspection.frame_live");
Input.Roi("roi_main",16,12,48,40);
Input.Model("template_model","template.board.anchor");
Action.Call("RegionBoundaryAnalysis");
Action.Call("LineMeasurement");
Action.Call("TemplateOrFeatureMatch");
Action.Call("BaselineFeatureExport");
Action.Call("AiTaskPackaging");
Action.Call("DecideAiRoute");
Action.Call("InferBySelectedRoute");
Check.FieldExists("route");
Check.FieldExists("outputs");
Check.RouteIn("AiRouteDecision","StayInCxcore|RouteToMlpack|UpgradeToTorchModule");
Output.Emit("AiRouteDecision");
Output.Emit("AiTaskResult");
Output.Conclusion("boundary_result_infer_route_status","pass_if_checks_ok");
Flow.End();

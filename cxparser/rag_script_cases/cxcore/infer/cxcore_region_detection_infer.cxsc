kind=module
layer=infer
module=cxcore
case=region_detection
mode=build-run
report=on
Flow.Begin("cxcore.region_detection");
Input.Image("source_image","infer.object_cluster.frame_017");
Input.Roi("roi_main",20,18,32,24);
Input.Param("search_type",1);
Input.Param("distance",2);
Action.Call("ObjectOrRegionDetection");
Check.FieldExists("boxes");
Check.CountGe("boxes",1);
Check.RectValid("boxes[0]");
Output.Emit("DetectionOutput");
Output.Conclusion("region_detection_status","pass_if_checks_ok");
Flow.End();

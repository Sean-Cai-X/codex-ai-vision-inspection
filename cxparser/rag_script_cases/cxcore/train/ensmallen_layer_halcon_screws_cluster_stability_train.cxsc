flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.halcon_screws_cluster_stability.train");
flow.set_layer("train");
flow.set_module("ensmallen_layer");
flow.set_feature("HalconScrewsClusterStabilityTrain");
flow.input_dataset("dataset.halcon_2605.thread_selection.ensmallen");
flow.input_split("halcon_cluster");
flow.input_artifact("bridge_manifest","halcon_ensmallen_review_bundle.json");
flow.input_artifact("bridge_table","halcon_ensmallen_review_table.tsv");
flow.input_artifact("sample_id","halcon_baseline_screws_001|halcon_param_screws_002|halcon_findcircle_screw_cluster_015|halcon_boundary_screws_016");
flow.input_artifact("input_image","torch_main_model/screws/screws_001.png|torch_main_model/screws/screws_002.png|cximage_main_thread/screws/screws_015.png|torch_main_model/screws/screws_016.png");
flow.input_artifact("bucket_hints","G0.halcon_baseline_manual|G1.param_tuning|G2.candidate_competition|G3.boundary_stress");
flow.input_artifact("defect_count","0");
flow.input_artifact("roi_ref","halcon_review_table.tsv::roi_ref");
flow.input_artifact("objective_ref","torch.optimization.objective_ref");
flow.input_artifact("threshold_ref","torch.optimization.threshold_ref");
flow.input_param("task_scope","cluster_stability_only");
flow.input_param("optimizer_name","lbfgs");
flow.input_param("max_evals",100);
flow.input_param("patience",10);
flow.input_param("epsilon",0.0005);
flow.input_param("replay_enable",1);
flow.input_param("objective_ref","torch.optimization.objective_ref");
flow.input_param("threshold_ref","torch.optimization.threshold_ref");
flow.call("ResolveHalconReviewBundle");
flow.call("EnsmallenMatchOptimize","halcon_baseline_screws_001");
flow.call("EnsmallenMatchOptimize","halcon_param_screws_002");
flow.call("EnsmallenMatchOptimize","halcon_findcircle_screw_cluster_015");
flow.call("EnsmallenMatchOptimize","halcon_boundary_screws_016");
flow.call("EnsmallenAggregateBestParams");
flow.call("EnsmallenSaveBestParams");
flow.expect_output("MeasuredBatchOptimizeResult");
flow.expect_output("MeasuredReplayResult");
flow.expect_field("best_param_sets");
flow.expect_field("sample_count");
flow.expect_field("best_params_ref");
flow.expect_field("summary_ref");
flow.expect_field("defect_count");
flow.check_scalar_eq("task_scope","cluster_stability_only");
flow.check_scalar_ge("sample_count",4);
flow.check_trace_contains("EnsmallenSaveBestParams");
flow.check_artifact_exists("batch_best_params.json");
flow.check_artifact_exists("batch_summary.json");
flow.finish();

flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.phase1_param_opt.train");
flow.set_layer("train");
flow.set_module("ensmallen_layer");
flow.set_feature("Phase1ParamOptimizeTrain");
flow.input_dataset("dataset.deeppcb.phase1.ensmallen");
flow.input_split("phase1");
flow.input_artifact("bridge_manifest","sample_bundle_draft.json");
flow.input_artifact("bridge_table","bridge_samples.tsv");
flow.input_artifact("sample_id","00041008|00041012|00041015|00041001|00041003|00041009|00041000|00041004|00041005|00041010|00041014|00041017|00041136|13000017|13000080|20085069|20085083|20085102|00041126|13000019|13000020|13000022|20085221|20085225");
flow.input_artifact("input_image","buckets/G0.baseline_stable/images|buckets/G1.tuning_target/images|buckets/G2.candidate_competition/images|buckets/G3.stress_boundary/images");
flow.input_artifact("template_image","buckets/G0.baseline_stable/templates|buckets/G1.tuning_target/templates|buckets/G2.candidate_competition/templates|buckets/G3.stress_boundary/templates");
flow.input_artifact("label_file","bridge_samples.tsv::label_file");
flow.input_artifact("defect_count","bridge_samples.tsv::defect_count");
flow.input_artifact("roi_ref","bridge_samples.tsv::roi_ref");
flow.input_artifact("match_gt","bridge_samples.tsv::match_gt_center");
flow.input_param("task_scope","parameter_optimization_only");
flow.input_param("optimizer_name","lbfgs");
flow.input_param("max_evals",100);
flow.input_param("patience",10);
flow.input_param("epsilon",0.0005);
flow.input_param("replay_enable",1);
flow.input_param("objective_ref","torch.optimization.objective_ref");
flow.input_param("threshold_ref","torch.optimization.threshold_ref");
flow.input_param("crop_policy_ref","torch.optimization.crop_policy_ref");
flow.input_param("boundary_error_ref","torch.optimization.boundary_error_ref");
flow.input_param("alignment_error_ref","torch.optimization.alignment_error_ref");
flow.call("ResolvePhase1SampleBundle");
flow.call("EnsmallenCircleOptimize");
flow.call("EnsmallenEllipseOptimize");
flow.call("EnsmallenMatchOptimize");
flow.call("EnsmallenAggregateBestParams");
flow.call("EnsmallenSaveBestParams");
flow.expect_output("MeasuredBatchOptimizeResult");
flow.expect_output("MeasuredReplayResult");
flow.expect_field("task_scope");
flow.expect_field("best_param_sets");
flow.expect_field("sample_count");
flow.expect_field("replay_log_path");
flow.expect_field("best_params_ref");
flow.expect_field("optimization_result_ref");
flow.expect_field("summary_ref");
flow.check_scalar_eq("task_scope","parameter_optimization_only");
flow.check_scalar_ge("sample_count",24);
flow.check_trace_contains("EnsmallenSaveBestParams");
flow.check_artifact_exists("batch_best_params.json");
flow.check_artifact_exists("batch_summary.json");
flow.finish();

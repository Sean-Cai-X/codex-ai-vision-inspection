kind=module
layer=train
module=cxcore
case=baseline_feature_train
mode=build-run
report=on
Flow.Begin("cxcore.baseline_feature_train");
Input.Dataset("dataset_train","dataset.cxcore.baseline.v1.train");
Input.Split("train");
Input.LabelField("label");
Action.Call("RegionBoundaryAnalysis");
Action.Call("LineMeasurement");
Action.Call("TemplateOrFeatureMatch");
Action.Call("BaselineFeatureExport");
Action.Call("AiTaskPackaging");
Action.Call("RouteToMlpack");
Action.Call("TrainNumericClassification");
Check.FieldExists("task");
Check.FieldExists("feature_set");
Check.FieldExists("accuracy");
Check.FieldExists("macro_f1");
Check.ScalarGe("feature_dim",1);
Check.ScalarBetween("accuracy",0,1);
Output.Emit("BaselineSummaryRecordV1");
Output.Conclusion("baseline_feature_train_status","pass_if_checks_ok");
Flow.End();

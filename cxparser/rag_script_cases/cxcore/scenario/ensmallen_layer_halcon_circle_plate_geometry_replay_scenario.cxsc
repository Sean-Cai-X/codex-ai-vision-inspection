flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.halcon_circle_plate_geometry_replay.scenario");
flow.set_layer("scenario");
flow.set_module("ensmallen_layer");
flow.set_feature("HalconCirclePlateGeometryReplayScenario");
flow.input_dataset("dataset.halcon_2605.thread_selection.ensmallen");
flow.input_sample("halcon_findcircle_circle_plate_01");
flow.input_sample("halcon_findcircle_radius_gauge_01");
flow.input_sample("halcon_geometry_topology_circle_plate_05");
flow.input_artifact("bridge_manifest","halcon_ensmallen_review_bundle.json");
flow.input_artifact("bridge_table","halcon_ensmallen_review_table.tsv");
flow.input_artifact("sample_id","halcon_findcircle_circle_plate_01|halcon_findcircle_radius_gauge_01|halcon_geometry_topology_circle_plate_05");
flow.input_artifact("input_image","cximage_main_thread/metal-parts/circle_plate_01.png|D:/Codex-WorkDir/Sean_WorkDir/local_test/halcon_2605_thread_selection/cximage_main_thread/radius-gauges/calib-01.png|cximage_main_thread/metal-parts/circle_plate_05.png");
flow.input_artifact("geometry_ref","halcon_review_table.tsv::geometry_ref");
flow.input_artifact("boundary_error_ref","halcon_review_table.tsv::boundary_error_ref");
flow.input_artifact("objective_ref","torch.optimization.objective_ref");
flow.input_param("repeat_count",3);
flow.input_param("replay_enable",1);
flow.input_param("compare_enable",1);
flow.input_param("task_scope","geometry_fit_stability");
flow.input_param("objective_ref","torch.optimization.objective_ref");
flow.input_param("boundary_error_ref","torch.optimization.boundary_error_ref");
flow.call("ResolveHalconReviewBundle");
flow.call("EnsmallenCircleOptimize","halcon_findcircle_circle_plate_01");
flow.call("EnsmallenCircleOptimize","halcon_findcircle_radius_gauge_01");
flow.call("EnsmallenCircleOptimize","halcon_geometry_topology_circle_plate_05");
flow.call("EnsmallenScenarioReplay");
flow.call("EnsmallenScenarioCompare");
flow.expect_output("MeasuredScenarioOptimizeResult");
flow.expect_output("MeasuredScenarioCompareResult");
flow.expect_output("MeasuredScenarioReplayResult");
flow.expect_field("sample_summaries");
flow.expect_field("pass_fail");
flow.expect_field("replay_log_path");
flow.expect_field("compare_ref");
flow.check_count_ge("sample_summaries",2);
flow.check_trace_contains("EnsmallenScenarioReplay");
flow.check_trace_contains("EnsmallenScenarioCompare");
flow.check_artifact_exists("scenario_compare.json");
flow.finish();

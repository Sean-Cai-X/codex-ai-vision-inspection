kind=module
layer=feature
module=cxcore
case=baseline_upstream_combo
mode=build-run
report=on
Flow.Begin("cxcore.baseline_upstream_combo.feature");
Input.Image("source_image","synthetic.baseline.upstream.primary");
Input.Image("template_model_image","synthetic.template.model");
Input.Image("search_image","synthetic.template.search");
Input.Roi("roi_main",16,24,48,32);
Input.Roi("roi_line",12,36,72,24);
Input.Roi("roi_circle",18,16,36,36);
Input.Roi("roi_match",20,20,40,28);
Action.UseModuleCase("cxcore","feature","region_boundary_analysis");
Action.UseModuleCase("cxcore","feature","line_measurement");
Action.UseModuleCase("cxcore","feature","circle_measurement");
Action.UseModuleCase("cxcore","feature","template_feature_match");
Action.UseModuleCase("cxcore","feature","baseline_feature_export");
Check.ScalarGe("region_connected_components_value",0);
Check.AnyNotEmpty("horizontal_samples","vertical_samples");
Check.ScalarGe("radius",0);
Check.ScalarGe("match_candidate_count_value",0);
Check.ScalarGe("roi_area",0);
Check.FieldExists("match_best_score");
Output.Emit("ImageAnalysisOutput");
Output.Emit("LineMeasurementOutput");
Output.Emit("CircleMeasurementOutput");
Output.Emit("MatchOutput");
Output.Emit("BaselineFeatureSampleV1");
Output.Conclusion("baseline_upstream_combo_feature_status","pass_if_checks_ok");
Flow.End();

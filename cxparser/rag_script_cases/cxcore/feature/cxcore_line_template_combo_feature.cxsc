kind=module
layer=feature
module=cxcore
case=line_template_combo
mode=build-run
report=on
Flow.Begin("cxcore.line_template_combo.feature");
Input.Image("source_image","synthetic.line_match.combo.primary");
Input.Image("template_model_image","synthetic.template.model");
Input.Image("search_image","synthetic.template.search");
Input.Roi("roi_main",16,24,48,32);
Input.Roi("roi_line",12,36,72,24);
Input.Roi("roi_match",20,20,40,28);
Input.Param("line_threshold",8);
Input.Param("line_gap",4);
Input.Param("compare_gap",4);
Input.Param("line_method",1);
Input.Param("match_threshold",8);
Input.Param("match_method",2);
Input.Param("match_score_threshold",0.1);
Input.Param("max_candidates",4);
Action.Call("measure_line");
Action.Call("learn_template_model");
Action.Call("match_template");
Check.AnyNotEmpty("horizontal_samples","vertical_samples");
Check.PointsInRoiNeighborhood("horizontal_samples|vertical_samples","roi_line",8);
Check.ScalarGe("match_candidate_count_value",0);
Check.RectNear("candidates[0].bounds",30,34,10);
Check.ScalarGt("candidates[0].score",0);
Output.Emit("LineMeasurementOutput");
Output.Emit("MatchOutput");
Output.Conclusion("line_template_combo_feature_status","pass_if_checks_ok");
Flow.End();

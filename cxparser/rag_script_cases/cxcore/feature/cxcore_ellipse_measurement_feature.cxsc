kind=module
layer=feature
module=cxcore
case=ellipse_measurement
mode=build-run
report=on
Flow.Begin("cxcore.ellipse_measurement.feature");
Input.Image("source_image","synthetic.ellipse.primary");
Input.Roi("roi_main",14,12,44,32);
Input.Roi("roi_ellipse",14,12,44,32);
Input.Param("threshold",10);
Input.Param("line_gap",4);
Input.Param("compare_gap",5);
Input.Param("method",2);
Action.Call("measure_ellipse");
Check.StructExists("measure_bounds");
Check.FieldExists("sample_points");
Output.Emit("EllipseMeasurementOutput");
Output.Conclusion("ellipse_measurement_feature_status","pass_if_checks_ok");
Flow.End();

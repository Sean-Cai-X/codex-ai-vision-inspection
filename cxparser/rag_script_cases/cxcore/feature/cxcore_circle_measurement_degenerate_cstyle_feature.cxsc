kind=module
layer=feature
module=cxcore
case=circle_measurement_degenerate
mode=build-run
report=on
Flow.Begin("cxcore.circle_measurement_degenerate.feature");
Input.Image("source_image","synthetic.geometry.circle_single");
Input.Roi("roi_circle",0,0,8,8);
Action.Call("measure_circle");
Check.Value("failure_mode","handled_degenerate_input");
Check.FieldExists("sample_points");
Output.Emit("CircleMeasurementOutput");
Output.Emit("circle_radius");
Output.Emit("center");
Output.Emit("average_distance");
Output.Emit("sample_points");
Output.Emit("failure_mode");
Output.Conclusion("circle_measurement_degenerate_status","pass_if_checks_ok");
Flow.End();

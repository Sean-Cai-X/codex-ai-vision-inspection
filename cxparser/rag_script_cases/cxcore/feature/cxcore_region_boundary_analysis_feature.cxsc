kind=module
layer=feature
module=cxcore
case=region_boundary_analysis
mode=build-run
report=on
input source_image;
input roi_main;
call analyze_region_boundary();
expect success == true;
expect task_id == "cxcore.feature.region_boundary_analysis";
expect scalar_result == 1034.000000;
emit task_id;
emit summary;

kind=module
layer=feature
module=cxcore
case=circle_measurement_boundary
mode=build-run
report=on
Flow.Begin("cxcore.circle_measurement_boundary.feature");
Input.Image("source_image","synthetic.geometry.circle_single");
Input.Roi("roi_circle",18,16,36,36);
Action.Call("measure_circle");
Check.Value("failure_mode","handled_boundary_condition");
Check.FieldExists("circle_radius");
Check.FieldExists("center");
Check.FieldExists("average_distance");
Check.FieldExists("sample_points");
Check.ScalarGt("radius",0);
Check.ScalarGe("sample_points",1);
Output.Emit("CircleMeasurementOutput");
Output.Emit("circle_radius");
Output.Emit("center");
Output.Emit("average_distance");
Output.Emit("sample_points");
Output.Emit("failure_mode");
Output.Conclusion("circle_measurement_boundary_status","pass_if_checks_ok");
Flow.End();

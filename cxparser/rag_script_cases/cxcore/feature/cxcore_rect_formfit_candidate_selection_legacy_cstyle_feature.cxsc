kind=module
layer=feature
module=cxcore
case=rect_formfit_candidate_selection_legacy
mode=build-run
report=on
Flow.Begin("cxcore.rect_formfit_candidate_selection_legacy");
Input.Image("source_image","synthetic.rect.formfit");
Input.Roi("roi_formfit",20,30,64,40);
Input.Param("fit_mode","legacy");
Action.Call("select_formfit_candidate");
Check.ScalarGe("candidate_count",1);
Check.ScalarGe("selected_index",0);
Check.ScalarGe("top1_score",0.50);
Check.RectValid("top1_rect");
Output.Emit("FormfitPrototype");
Output.Conclusion("rect_formfit_candidate_selection_legacy_status","pass_if_checks_ok");
Flow.End();

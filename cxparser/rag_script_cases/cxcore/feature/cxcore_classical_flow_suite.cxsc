kind=module
layer=feature
module=cxcore
case=classical_flow_suite
mode=build-run
report=on
Flow.Begin("cxcore.classical_flow_suite.feature");
Input.Image("source_image","synthetic.classical.flow.primary");
Input.Image("template_model_image","synthetic.template.model");
Input.Image("search_image","synthetic.template.search");
Input.Roi("roi_main",16,24,48,32);
Input.Roi("roi_line",12,36,72,24);
Input.Roi("roi_circle",18,16,36,36);
Input.Roi("roi_ellipse",14,12,44,32);
Input.Roi("roi_match",20,20,40,28);
Action.UseModuleCase("cxcore","feature","geometry_measurement_combo");
Action.UseModuleCase("cxcore","feature","classical_core_combo");
Check.ScalarGe("region_connected_components_value",0);
Check.AnyNotEmpty("horizontal_samples","vertical_samples");
Check.StructExists("measure_bounds");
Check.ScalarGe("radius",0);
Check.FieldExists("sample_points");
Check.ScalarGe("match_candidate_count_value",0);
Check.RectNear("candidates[0].bounds",30,34,10);
Output.Emit("ImageAnalysisOutput");
Output.Emit("LineMeasurementOutput");
Output.Emit("CircleMeasurementOutput");
Output.Emit("EllipseMeasurementOutput");
Output.Emit("MatchOutput");
Output.Conclusion("classical_flow_suite_status","pass_if_checks_ok");
Flow.End();

kind=module
layer=feature
module=cxcore
case=line_measurement
mode=build-run
report=on
use Image;
use Roi;
use LineMeasurementOutput;
Image source_image;
Roi roi_line;
LineMeasurementOutput line_result;
measure_line(source_image, roi_line);
check(success == true);
check(task_id == "cxcore.feature.line_measurement");
check(scalar_result == 1031.000000);
print(task_id);
print(summary);

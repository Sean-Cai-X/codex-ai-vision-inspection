kind=module
layer=feature
module=cxcore
case=baseline_feature_export
mode=build-run
report=on
Flow.Begin("cxcore.baseline_feature_export.feature");
Input.Image("source_image","synthetic.baseline.sample_a");
Input.Image("template_model_image","synthetic.template.model");
Input.Image("search_image","synthetic.template.search");
Input.Roi("roi_main",16,24,48,32);
Input.Roi("roi_line",12,36,72,24);
Input.Roi("roi_circle",18,16,36,36);
Input.Roi("roi_match",20,20,40,28);
Action.Call("analyze_region_boundary");
Action.Call("measure_line");
Action.Call("measure_circle");
Action.Call("learn_template_model");
Action.Call("match_template");
Action.Call("export_baseline_feature");
Check.ScalarGt("roi_area",0);
Check.ScalarGe("component_count",0);
Check.FieldExists("line_measure_bbox_w");
Check.FieldExists("circle_radius");
Check.FieldExists("match_best_score");
Check.SchemaContains("BaselineFeatureSampleV1","image_model_score");
Check.FieldExists("roi_patch_count");
Check.FieldExists("roi_class_label");
Check.FieldExists("roi_class_label_count");
Check.FieldExists("region_spatial_size");
Check.FieldExists("mask_or_region_label");
Check.FieldExists("mask_label_spatial_size");
Check.ScalarGe("roi_patch_count",1);
Check.ScalarGe("roi_class_label_count",1);
Check.ScalarGe("region_spatial_size",1);
Check.ScalarGe("mask_label_spatial_size",1);
Check.Value("roi_alignment_status","count_aligned");
Check.Value("mask_alignment_status","spatial_aligned");
Output.Emit("BaselineFeatureSampleV1");
Output.Emit("roi_patch_tensor");
Output.Emit("roi_patch_count");
Output.Emit("roi_patch_spatial_size");
Output.Emit("roi_class_label");
Output.Emit("roi_class_label_count");
Output.Emit("region_tensor");
Output.Emit("region_spatial_size");
Output.Emit("region_channel_layout");
Output.Emit("mask_or_region_label");
Output.Emit("mask_label_spatial_size");
Output.Conclusion("baseline_feature_export_feature_status","pass_if_checks_ok");
Flow.End();

kind=module
layer=feature
module=cxcore
case=ai_route_ready_combo
mode=build-run
report=on
Flow.Begin("cxcore.ai_route_ready_combo.feature");
Input.Image("source_image","synthetic.ai.route.primary");
Input.Image("template_model_image","synthetic.template.model");
Input.Image("search_image","synthetic.template.search");
Input.Roi("roi_main",8,8,24,24);
Input.Roi("roi_line",12,36,72,24);
Input.Roi("roi_circle",18,16,36,36);
Input.Roi("roi_match",20,20,40,28);
Action.UseModuleCase("cxcore","feature","region_boundary_analysis");
Action.UseModuleCase("cxcore","feature","line_measurement");
Action.UseModuleCase("cxcore","feature","circle_measurement");
Action.UseModuleCase("cxcore","feature","template_feature_match");
Action.UseModuleCase("cxcore","feature","baseline_feature_export");
Action.UseModuleCase("cxcore","feature","ai_task_packaging");
Check.ScalarGe("roi_area",0);
Check.FieldExists("match_best_score");
Check.Valid("AiTaskEnvelope");
Check.RouteIn("AiRouteDecision","StayInCxcore|RouteToMlpack|UpgradeToTorchModule");
Check.FieldExists("image_window_count");
Check.FieldExists("bbox_xyxy_targets");
Check.FieldExists("class_id_targets");
Check.FieldExists("target_count");
Check.FieldExists("roi_patch_count");
Check.FieldExists("roi_class_label");
Check.FieldExists("roi_class_label_count");
Check.FieldExists("roi_alignment_status");
Check.FieldExists("detection_target_alignment_status");
Check.ScalarGe("image_window_count",1);
Check.ScalarGe("target_count",1);
Check.Value("detection_target_alignment_status","target_count_aligned");
Check.Value("roi_alignment_status","count_aligned");
Output.Emit("BaselineFeatureSampleV1");
Output.Emit("AiTaskEnvelope");
Output.Emit("AiRouteDecision");
Output.Emit("image_window_tensor");
Output.Emit("image_window_count");
Output.Emit("resize_policy");
Output.Emit("bbox_candidate_list");
Output.Emit("bbox_xyxy_targets");
Output.Emit("class_id_targets");
Output.Emit("target_count");
Output.Emit("roi_patch_tensor");
Output.Emit("roi_patch_count");
Output.Emit("roi_class_label");
Output.Emit("roi_class_label_count");
Output.Emit("roi_alignment_status");
Output.Emit("detection_target_alignment_status");
Output.Conclusion("ai_route_ready_combo_feature_status","pass_if_checks_ok");
Flow.End();

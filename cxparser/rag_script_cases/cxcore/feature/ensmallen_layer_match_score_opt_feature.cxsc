flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.match_score_opt.feature");
flow.set_layer("feature");
flow.set_module("ensmallen_layer");
flow.set_feature("MatchScoreTuning");
flow.input_image("phase1.template_match.template_scene_rotated");
flow.input_model("phase1.template_match.template_patch");
flow.input_roi("roi_match",72,60,96,84);
flow.input_gt("match_gt","center=120,108");
flow.input_param_json("params","thre=8;comparegap=2;linegap=6;wgap=6;hgap=6;minscore=0.40");
flow.input_param_json("objective_weights","rank=4;location=3;margin=2;fp=2;score_stability=1.5");
flow.call("ResolveTuningCase");
flow.call("RunBaselineEval");
flow.call("RunMatchScoreTuning");
flow.call("CompareBaselineVsBest");
flow.call("ExportReplayLog");
flow.call("BuildRagExplainPacket");
flow.expect_output("MeasuredOptimizeResult");
flow.expect_output("MeasuredCompareResult");
flow.expect_output("MeasuredReplayResult");
flow.expect_output("RagWritebackNote");
flow.expect_field("baseline_objective");
flow.expect_field("best_objective");
flow.expect_field("objective_delta");
flow.expect_field("metric_delta");
flow.expect_field("replay_log_path");
flow.expect_field("pass_level");
flow.expect_field("candidate_group.candidates");
flow.expect_field("candidate_group.baseline_rank");
flow.expect_field("candidate_group.best_candidate_id");
flow.expect_field("candidate_group.group_score");
flow.expect_field("candidate_group.task_id");
flow.expect_field("candidate_group.problem_id");
flow.expect_field("candidate_group.config_id");
flow.expect_field("candidate_group.rank_delta");
flow.check_scalar_le("best_objective","baseline_objective");
flow.check_trace_contains("RunMatchScoreTuning");
flow.check_trace_contains("candidate_group");
flow.check_artifact_exists("replay_log.jsonl");
flow.finish();

kind=module
layer=smoke
module=cxcore
case=template_feature_match
mode=build-run
report=on
Flow.Begin("cxcore.template_feature_match");
Input.Image("source_image","synthetic.template.primary");
Input.Roi("roi_match",20,18,32,24);
Input.Model("template_model","template.basic.rect");
Input.Param("method",2);
Input.Param("threshold",13);
Input.Param("min_score",0.50);
Input.Param("max_candidates",3);
Action.Call("TemplateOrFeatureMatch");
Check.CountGe("candidates",1);
Check.RectValid("candidates[0].bounds");
Check.ScalarGe("candidates[0].score",0.50);
Check.FieldExists("max_score");
Check.FieldExists("image_model_score");
Output.Emit("MatchOutput");
Output.Conclusion("template_match_status","pass_if_checks_ok");
Flow.End();

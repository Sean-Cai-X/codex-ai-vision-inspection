kind=module
layer=smoke
module=cxcore
case=region_boundary_analysis
mode=build-run
report=on
Flow.Begin("cxcore.region_boundary_analysis");
Input.Image("source_image","synthetic.component.dual_blob");
Input.Param("min_area",1);
Input.Param("min_width",1);
Input.Param("min_height",1);
Action.Call("RegionBoundaryAnalysis");
Check.FieldExists("width");
Check.FieldExists("height");
Check.CountGe("connected_components",1);
Check.ComponentBoundsValid("connected_components");
Output.Emit("ImageAnalysisOutput");
Output.Conclusion("region_boundary_analysis_status","pass_if_checks_ok");
Flow.End();

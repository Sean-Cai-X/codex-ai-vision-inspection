flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.circle_objective.smoke");
flow.set_layer("smoke");
flow.set_module("ensmallen_layer");
flow.set_feature("CircleObjectiveSmoke");
flow.input_image("phase1.fit_circle.circle_double");
flow.input_roi("roi_circle",40,80,160,96);
flow.input_gt("circle_gt","center=88,128;radius=34");
flow.input_param_json("optimizer_init","thre=8;comparegap=2;gap=6;linesamplerate=0.004;fitmeasuregap=80");
flow.input_param_json("objective_weights","center=3;radius=2;avg_dist=2;invalid=4;stability=1.5");
flow.call("CircleMeasurement","roi_circle");
flow.call("BoundaryResultExport");
flow.call("EnsmallenCircleObjectiveEval");
flow.expect_output("CircleMeasurementOutput");
flow.expect_output("EnsmallenObjectiveResult");
flow.expect_field("circle_center_x");
flow.expect_field("circle_radius");
flow.expect_field("objective_value");
flow.check_scalar_ge("objective_value",0);
flow.check_trace_contains("EnsmallenCircleObjectiveEval");
flow.finish();

flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.match_objective.smoke");
flow.set_layer("smoke");
flow.set_module("ensmallen_layer");
flow.set_feature("MatchObjectiveSmoke");
flow.input_image("phase1.template_match.template_scene");
flow.input_model("phase1.template_match.template_patch");
flow.input_roi("roi_match",20,18,48,40);
flow.input_gt("match_gt","center=60,66");
flow.input_param_json("optimizer_init","thre=8;comparegap=2;linegap=6;wgap=6;hgap=6;minscore=0.40");
flow.input_param_json("objective_weights","rank=4;location=3;margin=2;fp=2;score_stability=1.5");
flow.call("TemplateOrFeatureMatch","roi_match");
flow.call("BoundaryResultExport");
flow.call("EnsmallenMatchObjectiveEval");
flow.expect_output("MatchOutput");
flow.expect_output("EnsmallenObjectiveResult");
flow.expect_field("candidates");
flow.expect_field("objective_value");
flow.check_count_ge("candidates",1);
flow.check_scalar_ge("objective_value",0);
flow.check_trace_contains("EnsmallenMatchObjectiveEval");
flow.finish();

flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.ellipse_objective.smoke");
flow.set_layer("smoke");
flow.set_module("ensmallen_layer");
flow.set_feature("EllipseObjectiveSmoke");
flow.input_image("phase1.fit_ellipse.ellipse_rotated");
flow.input_roi("roi_ellipse",48,52,168,136);
flow.input_gt("ellipse_gt","center=132,120;bbox=62,90,140,60");
flow.input_param_json("optimizer_init","thre=8;comparegap=2;gap=6;linesamplerate=0.004");
flow.input_param_json("objective_weights","bbox_center=3;bbox_size=2;fit_residual=2.5;coverage=1.5;stability=1.5");
flow.call("EllipseMeasurement","roi_ellipse");
flow.call("BoundaryResultExport");
flow.call("EnsmallenEllipseObjectiveEval");
flow.expect_output("EllipseMeasurementOutput");
flow.expect_output("EnsmallenObjectiveResult");
flow.expect_field("sample_points");
flow.expect_field("objective_value");
flow.check_count_ge("sample_points.points",1);
flow.check_scalar_ge("objective_value",0);
flow.check_trace_contains("EnsmallenEllipseObjectiveEval");
flow.finish();

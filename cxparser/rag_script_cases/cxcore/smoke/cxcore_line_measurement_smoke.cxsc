kind=module
layer=smoke
module=cxcore
case=line_measurement
mode=build-run
report=on
Flow.Begin("cxcore.line_measurement");
Input.Image("source_image","synthetic.line.primary");
Input.Roi("roi_line",16,12,48,40);
Input.Param("threshold",12);
Input.Param("line_gap",6);
Input.Param("compare_gap",4);
Action.Call("LineMeasurement");
Check.AnyNotEmpty("horizontal_samples","vertical_samples");
Check.StructExists("measure_bounds");
Check.PointsInRoiNeighborhood("horizontal_samples|vertical_samples","roi_line",8);
Output.Emit("LineMeasurementOutput");
Output.Conclusion("line_measurement_status","pass_if_checks_ok");
Flow.End();

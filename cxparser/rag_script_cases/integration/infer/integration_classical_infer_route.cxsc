kind=integration
layer=infer
module=integration
case=classical_infer_route
mode=build-run
report=on
Flow.Begin("integration.classical_infer_route");
Input.Image("source_image","infer.board_inspection.frame_live");
Input.Model("template_model","template.board.anchor");
Action.UseModuleCase("cxcore","smoke","region_boundary_analysis");
Action.UseModuleCase("cxcore","smoke","line_measurement");
Action.UseModuleCase("cxcore","smoke","template_feature_match");
Action.UseModuleCase("cxcore","feature","baseline_feature_export");
Action.UseModuleCase("cxcore","feature","ai_task_packaging");
Action.Call("DecideAiRoute");
Action.Call("InferBySelectedRoute");
Check.RouteIn("AiRouteDecision","StayInCxcore|RouteToMlpack|UpgradeToTorchModule");
Output.Emit("AiRouteDecision");
Output.Emit("AiTaskResult");
Output.Conclusion("integration_classical_infer_route_status","pass_if_checks_ok");
Flow.End();

kind=integration
layer=infer
module=integration
case=detection_infer
mode=build-run
report=on
Flow.Begin("integration.detection_infer");
Input.Image("source_image","infer.object_cluster.frame_017");
Action.UseModuleCase("cximage","operator","roi_threshold");
Action.UseModuleCase("cximage","matcher","findobject_region");
Action.UseModuleCase("cxcore","infer","region_detection");
Check.ScalarGe("result_count",0);
Check.RectValid("boxes[0]");
Output.Emit("FindObjectResults");
Output.Emit("DetectionOutput");
Output.Conclusion("integration_detection_infer_status","pass_if_checks_ok");
Flow.End();

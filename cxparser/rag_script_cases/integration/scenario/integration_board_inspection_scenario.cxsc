kind=integration
layer=scenario
module=integration
case=board_inspection_scenario
mode=build-run
report=on
Flow.Begin("integration.board_inspection_scenario");
Input.Image("source_image","scenario.board_inspection.frame_001");
Input.Model("template_model","template.board.anchor");
Action.UseModuleCase("cximage","operator","roi_edge");
Action.UseModuleCase("cxcore","smoke","line_measurement");
Action.UseModuleCase("cxcore","smoke","region_boundary_analysis");
Action.UseModuleCase("cximage","matcher","fastmatch_template");
Action.UseModuleCase("cxcore","smoke","template_feature_match");
Check.AnyNotEmpty("horizontal_samples","vertical_samples");
Check.CountGe("connected_components",1);
Check.CountGe("candidates",1);
Output.Emit("LineMeasurementOutput");
Output.Emit("ImageAnalysisOutput");
Output.Emit("MatchOutput");
Output.Conclusion("integration_board_inspection_status","pass_if_checks_ok");
Flow.End();

kind=integration
layer=smoke
module=integration
case=classical_boundary_smoke
mode=build-run
report=on
Flow.Begin("integration.classical_boundary_smoke");
Input.Image("source_image","synthetic.integration.classical_boundary");
Action.UseModuleCase("cximage","operator","roi_threshold");
Action.UseModuleCase("cximage","operator","roi_edge");
Action.UseModuleCase("cxcore","smoke","region_boundary_analysis");
Action.UseModuleCase("cxcore","smoke","line_measurement");
Check.CountGe("connected_components",1);
Check.StructExists("measure_bounds");
Output.Emit("ImageAnalysisOutput");
Output.Emit("LineMeasurementOutput");
Output.Conclusion("integration_classical_boundary_status","pass_if_checks_ok");
Flow.End();

kind=integration
layer=train
module=integration
case=baseline_feature_train
mode=build-run
report=on
Flow.Begin("integration.baseline_feature_train");
Input.Dataset("dataset_train","dataset.cxcore.baseline.v1.train");
Input.Split("train");
Input.LabelField("label");
Action.UseModuleCase("cximage","operator","roi_gray_count");
Action.UseModuleCase("cximage","feature","binary_region");
Action.UseModuleCase("cxcore","smoke","region_boundary_analysis");
Action.UseModuleCase("cxcore","smoke","line_measurement");
Action.UseModuleCase("cxcore","smoke","template_feature_match");
Action.UseModuleCase("cxcore","feature","baseline_feature_export");
Action.UseModuleCase("cxcore","feature","ai_task_packaging");
Action.Call("RouteToMlpack");
Action.Call("TrainNumericClassification");
Check.ScalarGe("feature_dim",1);
Check.ScalarBetween("accuracy",0,1);
Output.Emit("BaselineFeatureSampleV1");
Output.Emit("BaselineSummaryRecordV1");
Output.Conclusion("integration_baseline_feature_train_status","pass_if_checks_ok");
Flow.End();

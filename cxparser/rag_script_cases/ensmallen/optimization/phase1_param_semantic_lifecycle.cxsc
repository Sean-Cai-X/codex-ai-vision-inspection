flow=CxCoreFlowHost();
flow.set_case("cxcore.ensmallen_layer.phase1_param_replay.scenario");
flow.set_layer("scenario");
flow.set_module("ensmallen_layer");
flow.set_feature("Phase1ParamReplayScenario");
flow.input_dataset("dataset.deeppcb.phase1.ensmallen");
flow.input_artifact("bridge_manifest","sample_bundle_draft.json");
flow.input_artifact("bridge_table","bridge_samples.tsv");
flow.input_artifact("input_image","buckets/G0.baseline_stable/images|buckets/G1.tuning_target/images|buckets/G2.candidate_competition/images|buckets/G3.stress_boundary/images");
flow.input_artifact("template_image","buckets/G0.baseline_stable/templates|buckets/G1.tuning_target/templates|buckets/G2.candidate_competition/templates|buckets/G3.stress_boundary/templates");
flow.input_artifact("label_file","bridge_samples.tsv::label_file");
flow.input_artifact("roi_ref","bridge_samples.tsv::roi_ref");
flow.input_artifact("match_gt","bridge_samples.tsv::match_gt_center");
flow.input_param("optimization_domain","template_match_parameter_tuning");
flow.input_param("optimizer_ref","ensmallen.lbfgs.phase1");
flow.input_param("param_ref","ensmallen_layer.phase1.params");
flow.input_param("objective_ref","torch.optimization.objective_ref");
flow.input_param("candidate_ref","ensmallen_layer.phase1.candidates");
flow.input_param("best_ref","ensmallen_layer.phase1.best_candidate");
flow.input_param("stability_ref","ensmallen_layer.phase1.stability");
flow.input_param("failed_candidate_ref","ensmallen_layer.phase1.failed_candidate");
flow.input_param("intermediate_candidate_ref","ensmallen_layer.phase1.intermediate_candidate");
flow.input_param("init_ref","ensmallen_layer.phase1.initialize");
flow.input_param("search_ref","ensmallen_layer.phase1.search");
flow.input_param("compare_stage_ref","ensmallen_layer.phase1.compare");
flow.input_param("convergence_ref","ensmallen_layer.phase1.convergence");
flow.input_param("failure_ref","ensmallen_layer.phase1.failure");
flow.input_param("lifecycle_rule","init_resets_state;run_resets_candidates;debug_step_keeps_state;replay_readonly");
flow.input_param("debug_rule","single_step_candidate_eval;single_step_objective_compare;single_step_stability_check");
flow.input_param("replay_rule","load_best_params;load_candidate_trace;do_not_mutate_optimizer_state");
flow.call("ResolvePhase1SampleBundle");
flow.call("InitializeOptimizationState");
flow.call("RunCandidateSearch");
flow.call("CompareCandidateSet");
flow.call("SelectBestCandidate");
flow.call("CheckStability");
flow.call("ExportOptimizationReplay");
flow.expect_output("MeasuredScenarioReplayResult");
flow.expect_field("param_ref");
flow.expect_field("objective_ref");
flow.expect_field("candidate_ref");
flow.expect_field("best_ref");
flow.expect_field("stability_ref");
flow.expect_field("replay_ref");
flow.expect_field("stage_summary");
flow.expect_field("manual_judge_entry");
flow.check_trace_contains("InitializeOptimizationState");
flow.check_trace_contains("RunCandidateSearch");
flow.check_trace_contains("CompareCandidateSet");
flow.check_trace_contains("CheckStability");
flow.finish();

case_id="torch.mobilevit.session.feature";
layer="feature";
module="torch_module";
model="MobileViTv2";
input_profile="full-train";
input_task="torch.feature.mobilevit.session";
prepared_root="prepared/PCBA-sample-YOLO";
dataset_profile="two_stage_detection_roi_reclass";
required_input_contract="roi_patch_batch_for_reclass";
required_label_contract="roi_patch_batch_plus_roi_class_label";
input_tensor="random.bchw.4x3x256x256";
input_target="random.class.labels.b4";
geometry_input_prior="roi_patch_or_candidate_crop";
geometry_label_align="roi_class_label";
attach_back_result="roi_reclass_score";
feature_output_1="session_summary";
feature_output_2="trainer_lifecycle_summary";
feature_output_3="trainer_flat_run";
flow_step_1="load_roi_patches_and_labels";
flow_step_2="run_mobilevit_mainline_session";
flow_step_3="collect_session_and_lifecycle_result";
flow_step_4="emit_feature_report_for_geometry_attach";
expected_output="TorchStageReport";
expected_summary="mobilevit session feature ready";
expected_check_1="mobilevit_mainline_session";
expected_check_2="mobilevit_trainer_lifecycle_summary";
check_point_1="session_must_pass";
check_point_2="trainer_lifecycle_must_pass";
check_point_3="classification_metrics_must_be_finite";
bound_test_result_1="build_full_train_mobilevit_unified_bundle:ALL_TESTS_PASSED";
conclusion_pass="mobilevit_session_feature_ready";
conclusion_attach="attach_roi_reclass_score_back_to_geometry_layer";
host=TorchTestHost();
report=host.run_task_report("torch.feature.mobilevit.session");
report_line=TorchTestHost::format_report_line(report);
check_lines=TorchTestHost::format_check_lines(report);
check(readresult("dataset.dataset_profile") == "two_stage_detection_roi_reclass");
check(readresult("dataset.prepared_root") == "prepared/PCBA-sample-YOLO");
check(readresult("dataset.required_input_contract") == "roi_patch_batch_for_reclass");
check(readresult("dataset.required_label_contract") == "roi_patch_batch_plus_roi_class_label");

case_id="torch.yolov8.eval.feature";
layer="feature";
module="torch_module";
model="YOLOv8";
input_profile="full-dataset";
input_task="torch.feature.yolo.eval";
input_val_images="images/val";
input_val_labels="labels/val";
input_use_dfl="true";
geometry_input_prior="whole_image_or_search_window";
geometry_label_align="bbox_plus_class_aligned_to_image";
attach_back_result="bbox_class_score_candidates";
feature_output_1="tp_fp_fn";
feature_output_2="per_class_metrics";
feature_output_3="bbox_eval_attach_reference";
flow_step_1="load_validation_images_and_labels";
flow_step_2="run_yolo_eval_summary_contract";
flow_step_3="collect_tp_fp_fn_and_per_class_metrics";
flow_step_4="emit_feature_report_for_geometry_attach";
expected_output="TorchStageReport";
expected_summary="full-dataset stage passed";
expected_metric_1="tp_fp_fn";
expected_metric_2="per_class_metrics";
expected_check_1="yolo_eval_summary_contract";
check_point_1="tp_fp_fn_must_be_reported";

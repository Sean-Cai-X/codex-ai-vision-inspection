conclusion_attach="attach_mask_region_boundary_back_to_geometry_layer";
host=TorchTestHost();
report=host.run_current_profile_report();
report_line=TorchTestHost::format_report_line(report);
check_lines=TorchTestHost::format_check_lines(report);
check(readresult("dataset.dataset_profile") == "detection_with_template_pair");
check(readresult("dataset.required_label_contract") == "region_tensor_plus_mask_or_region_label");

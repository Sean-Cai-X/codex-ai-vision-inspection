case_id="torch.deeplab.contract.feature";
layer="feature";
module="torch_module";
model="DeepLab";
input_profile="full-all";
input_task="torch.feature.deeplab.contract";
prepared_root="prepared/DeepPCB-YOLO";
dataset_profile="detection_with_template_pair";
required_input_contract="region_tensor_for_segmentation_infer";
required_label_contract="region_tensor_plus_mask_or_region_label";
input_tensor="random.bchw.1x3x128x128";
input_target="mask_or_region_label";
geometry_input_prior="whole_region_or_boundary_sensitive_patch";
geometry_label_align="mask_or_region_label";
attach_back_result="mask_region_boundary_attach";
feature_output_1="segmentation_output_shape";
feature_output_2="finite_outputs";
feature_output_3="mask_region_boundary_attach";
flow_step_1="load_segmentation_tensor";
flow_step_2="run_deeplab_forward_contracts";
flow_step_3="verify_decoder_output_and_mask_alignment";
flow_step_4="emit_feature_report_for_geometry_attach";
expected_output="TorchStageReport";
expected_check_1="deeplabv3_contract";
expected_check_2="deeplabv3_plus_contract";
expected_metric_1="segmentation_output_shape";
expected_metric_2="finite_outputs";
check_point_1="segmentation_output_shape_must_match";

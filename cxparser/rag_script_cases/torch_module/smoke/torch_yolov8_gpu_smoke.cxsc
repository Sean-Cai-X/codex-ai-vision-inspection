case_id="torch.yolov8.gpu.smoke";
layer="smoke";
module="torch_module";
model="YOLOv8";
input_profile="full-train";
input_task="torch.smoke.yolo.gpu";
input_device="cuda";
input_tensor="random.bchw.2x3x64x64";
input_target="random.detect.targets.b2.n4";
baseline_param_batch_size="2";
baseline_param_input_size="64";
baseline_param_resize_policy="letterbox";
baseline_param_use_dfl="true";
contract_entry="run_yolo_smoke_train_step";
bridge_dependency_1="TorchTestHost::run_full_train_report";
bridge_dependency_2="torch_yolo_mainline_bridge.h";
blocking_point_1="gpu_full_session_not_yet_scripted";
blocking_point_2="cxscript_still_relies_on_host_report";
geometry_input_prior="whole_image_or_search_window";
geometry_label_align="bbox_plus_class_aligned_to_image";
attach_back_result="bbox_class_score_candidates";
flow_step_1="prepare_detection_tensor_and_targets_on_cuda";
flow_step_2="run_yolo_gpu_smoke_gate";
flow_step_3="verify_cuda_device_loss_and_backward";
flow_step_4="collect_stage_report_and_checks";
expected_output="TorchStageReport";
expected_summary="full-train stage passed";
expected_check_1="yolo_gpu_smoke";
expected_metric_1="device=cuda:0";
expected_metric_2="loss=finite";
check_point_1="device_must_be_cuda";
check_point_2="loss_must_be_finite";
check_point_3="backward_must_succeed";
bound_test_result_1="build_full_train_yolo_gpu_smoke_fix:ALL_TESTS_PASSED";
conclusion_pass="yolo_gpu_smoke_ready";
conclusion_attach="attach_gpu_verified_bbox_candidates_back_to_geometry_layer";
host=TorchTestHost();
report=host.run_full_train_report();
report_line=TorchTestHost::format_report_line(report);
check_lines=TorchTestHost::format_check_lines(report);

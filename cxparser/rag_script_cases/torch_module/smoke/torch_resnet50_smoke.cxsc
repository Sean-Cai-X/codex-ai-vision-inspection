input_device="cpu";
input_tensor="random.bchw.1x3x224x224";
geometry_input_prior="aligned_patch_or_baseline_roi";
geometry_label_align="patch_level_class_label";
attach_back_result="baseline_class_and_feature_reference";
flow_step_1="prepare_baseline_patch_tensor";
flow_step_2="run_classifier_forward";
flow_step_3="run_forward_features_p3_p4_p5";

EnsmallenTuning m_tuning;

m_tuning.setdataset("dataset.deeppcb.phase1.ensmallen");
m_tuning.setbucket("G0,G1,G2,G3,G4");

m_tuning.setparam("threshold", 0.72);
m_tuning.setparam("crop_policy", "roi_center_guard");
m_tuning.setobjective("template_alignment_error");

m_tuning.run();
m_tuning.replay();

global_param_ref = m_tuning.param_ref();
global_objective_ref = m_tuning.objective_ref();
global_replay_ref = m_tuning.replay_ref();
global_best_params_ref = m_tuning.best_params_ref();
global_current_status = "PENDING";
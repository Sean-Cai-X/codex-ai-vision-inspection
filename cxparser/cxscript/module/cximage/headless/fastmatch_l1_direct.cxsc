double min_score = global_min_score;
int min_score_percent = global_min_score_percent;
if (min_score_percent > 0) {
  min_score = min_score_percent / 100.0;
}
int find_num = global_find_num;
int match_step_x = global_match_step_x;
int match_step_y = global_match_step_y;
int match_thre = global_match_thre;
int fastmatch_action = global_fastmatch_action;

if (wgap <= 0)

{

  wgap = 15;
}

if (hgap <= 0) {
  hgap = 15;
}

if (compare_gap <= 0) {
  compare_gap = 20;
}
if (objfilter <= 0) {
  objfilter = 1;
}
if (learn_wgap_0 <= 0) {
  learn_wgap_0 = wgap;
}
if (learn_hgap_0 <= 0) {
  learn_hgap_0 = hgap;
}
if (learn_threshold_0 <= 0) {
  learn_threshold_0 = threshold;
}
if (learn_linegap_0 <= 0) {
  learn_linegap_0 = linegap;
}

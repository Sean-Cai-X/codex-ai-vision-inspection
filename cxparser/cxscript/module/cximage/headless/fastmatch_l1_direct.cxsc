  learn_linegap_3 = linegap;
}
if (learn_objfilter_3 <= 0) {
  learn_objfilter_3 = objfilter;
}
if (learn_compare_gap_3 <= 0) {
  learn_compare_gap_3 = compare_gap;
}
if (fastmatch_action <= 0) {
  fastmatch_action = 3;
}

m_match.setrectxywh(learn_x, learn_y, learn_w, learn_h);
m_match.setobjfilter(objfilter);
m_match.setwhgap(wgap, hgap);
m_match.setthre(threshold);
m_match.setlinegap(linegap);
m_match.setcompgap(compare_gap);
m_match.setlearnwgap(0, learn_wgap_0);
m_match.setlearnhgap(0, learn_hgap_0);
m_match.setlearnmethod(0, learn_method_0);
m_match.setlearnthre(0, learn_threshold_0);
m_match.setlearnlinegap(0, learn_linegap_0);
m_match.setlearnobjfilter(0, learn_objfilter_0);
m_match.setlearncompgap(0, learn_compare_gap_0);

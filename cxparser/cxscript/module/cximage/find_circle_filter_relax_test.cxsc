Image m_image;
FindCircle m_circle;

m_image.copyFromMat(global_matInput);

int cx = 765;
int cy = 471;
int px = 1200;
int py = 471;
int method = 0;
int threshold = 20;
int gap = 5;
int linegap = 3;

m_circle.Setgap(gap);
m_circle.setlinegap(linegap);
m_circle.setthre(threshold);
m_circle.setmethod(method);
int findsetting = 1;
int filter_borw = 21;
int filter_min = 1;
int filter_max = 100000;
m_circle.setfindsetting(findsetting);
m_circle.setfilter(filter_borw, filter_min, filter_max);
m_circle.setcircle(py, px, cy, cx);
m_circle.measure(&m_image);
m_circle.fitcircle();

global_circle_ref = m_circle.get_result();
global_current_status = "PENDING";

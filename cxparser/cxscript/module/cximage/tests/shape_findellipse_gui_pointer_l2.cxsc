CxShapeTest_reset(0);

CxShapeTest_addcase("findellipse_create_drag_release");
CxShapeTest_settool("findellipse_gauge");
CxShapeTest_setoperation("gui_pointer_create");
CxShapeTest_setpointersequence("drag_release");
CxShapeTest_setfrom(100, 100);
CxShapeTest_setto(180, 140);
CxShapeTest_setexpectedshapedelta(1);
CxShapeTest_setexpectedcreatedkind("EllipseShape");
CxShapeTest_setexpectedphase("create_shape");
CxShapeTest_setexpectedstatus("created");


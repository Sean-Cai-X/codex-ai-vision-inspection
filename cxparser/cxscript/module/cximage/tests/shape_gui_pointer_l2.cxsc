CxShapeTest_reset(0);

CxShapeTest_addcase("gui_create_point");
CxShapeTest_settool("point_pick");
CxShapeTest_setoperation("gui_pointer_create");
CxShapeTest_setpointersequence("click");
CxShapeTest_setfrom(100, 100);
CxShapeTest_setexpectedshapedelta(1);
CxShapeTest_setexpectedcreatedkind("PointsShape");
CxShapeTest_setexpectedphase("create_shape");
CxShapeTest_setexpectedstatus("created");


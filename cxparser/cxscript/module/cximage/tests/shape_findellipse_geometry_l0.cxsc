CxShapeTest_reset(0);

CxShapeTest_addcase("findellipse_l1_geometry");
CxShapeTest_settool("findellipse_gauge");
CxShapeTest_setoperation("runtime_geometry_publish");
CxShapeTest_setmanifest("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/test_images/stage25_image_manifest.json");
CxShapeTest_setmanifesttarget("ellipse_high_contrast_001,bottle_mouth_outer_ellipse");

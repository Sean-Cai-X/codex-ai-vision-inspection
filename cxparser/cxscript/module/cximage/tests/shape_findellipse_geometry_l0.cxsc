CxShapeTest_expecteditable(1);
CxShapeTest_expecteditableelement(0);
CxShapeTest_expectgeometrykind("EllipseShape");
CxShapeTest_expectpointcount(3);
CxShapeTest_expectmanifestgeometry(1);


CxShapeTest_sethandle("Corner0");
CxShapeTest_setfrom(100, 100);
CxShapeTest_setto(80, 80);
CxShapeTest_setexpected("corner0_moved_others_unchanged");

CxShapeTest_addcase("circle_drag_center");

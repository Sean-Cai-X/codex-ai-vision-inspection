CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialellipse(40, 80, 180, 200);
CxShapeTest_sethandle("Center");
CxShapeTest_setfrom(200, 180);
CxShapeTest_setto(220, 200);
CxShapeTest_setexpected("translate_only");

CxShapeTest_addcase("ellipse_drag_radius_x");
CxShapeTest_settool("ellipse_manual");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialellipse(40, 80, 180, 200);
CxShapeTest_sethandle("RadiusX");
CxShapeTest_setfrom(280, 180);
CxShapeTest_setto(300, 180);
CxShapeTest_setexpected("radius_x_only");

CxShapeTest_addcase("ellipse_drag_radius_y");
CxShapeTest_settool("ellipse_manual");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialellipse(40, 80, 180, 200);
CxShapeTest_sethandle("RadiusY");
CxShapeTest_setfrom(200, 220);
CxShapeTest_setto(200, 240);

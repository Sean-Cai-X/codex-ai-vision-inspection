CxShapeTest_setto(220, 200);
CxShapeTest_setexpected("translate_only");

CxShapeTest_addcase("circle_drag_radius");
CxShapeTest_settool("circle_roi");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialcircle(200, 180, 80);
CxShapeTest_sethandle("Radius");
CxShapeTest_setfrom(280, 180);
CxShapeTest_setto(300, 180);
CxShapeTest_setexpected("outer_radius_only");

CxShapeTest_addcase("ellipse_drag_center");

CxShapeTest_reset(0);

CxShapeTest_addcase("line_drag_center");
CxShapeTest_settool("scan_line");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialpoints("100,150,250,150");
CxShapeTest_sethandle("Center");
CxShapeTest_setfrom(175, 150);
CxShapeTest_setto(195, 170);
CxShapeTest_setexpected("translate_only");

CxShapeTest_addcase("line_drag_start");
CxShapeTest_settool("scan_line");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialpoints("100,150,250,150");
CxShapeTest_sethandle("Start");
CxShapeTest_setfrom(100, 150);
CxShapeTest_setto(80, 170);
CxShapeTest_setexpected("start_moved_end_unchanged");

CxShapeTest_addcase("line_drag_end");
CxShapeTest_settool("scan_line");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialpoints("100,150,250,150");
CxShapeTest_sethandle("End");
CxShapeTest_setfrom(250, 150);
CxShapeTest_setto(270, 130);
CxShapeTest_setexpected("end_moved_start_unchanged");

CxShapeTest_addcase("rect_drag_center");
CxShapeTest_settool("roi_rect");

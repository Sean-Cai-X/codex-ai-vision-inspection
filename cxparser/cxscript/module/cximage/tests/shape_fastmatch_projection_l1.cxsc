CxShapeTest_reset(0);

CxShapeTest_addcase("fastmatch_publish_roi");
CxShapeTest_settool("FastMatch");
CxShapeTest_setoperation("runtime_geometry_publish");
CxShapeTest_setimage("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/01.jpg");
CxShapeTest_setfrom(100, 100);
CxShapeTest_setownerbinding("FastMatch.test_case");
CxShapeTest_setinitiallearnrect(80, 80, 180, 180);
CxShapeTest_setinitialsearchrect(200, 200, 400, 400);

CxShapeTest_setrole("learn_roi");
CxShapeTest_expectrole(1);
CxShapeTest_expecteditable(1);
CxShapeTest_expecteditableelement(0);

CxShapeTest_setrole("search_roi");
CxShapeTest_expectrole(1);
CxShapeTest_expecteditable(1);
CxShapeTest_expecteditableelement(0);

CxShapeTest_addcase("fastmatch_republish_no_duplicate_refs");
CxShapeTest_settool("FastMatch");
CxShapeTest_setoperation("runtime_geometry_publish");
CxShapeTest_setimage("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/01.jpg");
CxShapeTest_setfrom(100, 100);
CxShapeTest_setownerbinding("FastMatch.test_case2");
CxShapeTest_setinitiallearnrect(50, 50, 150, 150);
CxShapeTest_setinitialsearchrect(180, 180, 380, 380);

CxShapeTest_setrole("learn_roi");
CxShapeTest_expectrole(1);

CxShapeTest_setrole("search_roi");
CxShapeTest_expectrole(1);

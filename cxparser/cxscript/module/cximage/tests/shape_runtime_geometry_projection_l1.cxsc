CxShapeTest_reset(0);

CxShapeTest_addcase("findline_geometry_publish");
CxShapeTest_settool("findline_gauge");
CxShapeTest_setoperation("runtime_geometry_publish");
CxShapeTest_setinitialline(100, 150, 250, 150);
CxShapeTest_setwhgap(2, 2);
CxShapeTest_settoolhalfwidth(10);
CxShapeTest_setlinegap(3);
CxShapeTest_setthreshold(20);
CxShapeTest_setmethod(0);
CxShapeTest_setrole("roi");
CxShapeTest_expectrole(1);
CxShapeTest_expecteditable(1);
CxShapeTest_expecteditableelement(0);
CxShapeTest_setrole("scan");
CxShapeTest_expectrole(1);
CxShapeTest_expecteditable(0);
CxShapeTest_expecteditableelement(0);


CxShapeTest_reset(0);

CxShapeTest_addcase("point_create");
CxShapeTest_settool("point_pick");
CxShapeTest_setoperation("create");
CxShapeTest_setexpected("point_visible");

CxShapeTest_addcase("point_drag");
CxShapeTest_settool("point_pick");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_sethandle("Vertex");
CxShapeTest_setfrom(100, 100);
CxShapeTest_setto(130, 145);
CxShapeTest_setexpected("target_moved_only");


Image m_image;
FindLine m_line;

m_image.copyFromMat(global_matInput);

int x0 = 120;
int y0 = 240;
int x1 = 980;
int y1 = 240;

int method = 0;
int threshold = 20;
int linegap = 6;
int fitmode = 1;

int wgap = 8;
int hgap = 32;
int script_scale = 1;

m_line.SetWHgap(wgap, hgap);
m_line.setline(x0, y0, x1, y1, script_scale);

int hgap2 = 48;
m_line.SetWHgap(wgap, hgap2);

m_line.setmethod(method);
m_line.setthre(threshold);
m_line.setlinegap(linegap);
m_line.setfitmode(fitmode);

m_line.measure(&m_image);
m_line.fitline();

global_line_ref = m_line.get_result();
global_current_status = "PENDING";

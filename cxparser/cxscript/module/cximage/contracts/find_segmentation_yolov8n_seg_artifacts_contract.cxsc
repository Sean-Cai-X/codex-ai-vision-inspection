    global_contract_status = "findsegmentation_yolov8n_seg_not_rendered";
    global_contract_conclusion = "FindSegmentation YOLOv8n-Seg instance geometry was not rendered";
}

if (global_result_overlay_changed_pixels < 1) {
    global_contract_pass = 0;
    global_contract_status = "findsegmentation_yolov8n_seg_overlay_blank";
    global_contract_conclusion = "FindSegmentation YOLOv8n-Seg result overlay did not change the image";
}

Image m_image;
FindCircle m_circle;

m_image.copyFromMat(global_matInput);

int cx = 765;
int cy = 471;
int inner = 0;
int radius = 477;
int circleGap = 80;

int method = 0;
int threshold = 20;
int gap = 5;
int linegap = 3;
int fitMeasureGap = 80;

m_circle.setcircle(radius, inner, cy, cx);
m_circle.setcirclegap(circleGap);
m_circle.setmethod(method);
m_circle.Setgap(gap);
m_circle.setthre(threshold);
m_circle.setlinegap(linegap);
m_circle.setfitmeasuregap(fitMeasureGap);

m_circle.measure(&m_image);
m_circle.fitcircle();
m_circle.FitResultMeasure(&m_image);

1+1;

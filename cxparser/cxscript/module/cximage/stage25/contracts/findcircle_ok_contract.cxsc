global_contract_pass = 1;
global_contract_status = "findcircle_ok_passed";
global_contract_conclusion = "FindCircle OK: circle points and fitted circle are available.";

if (global_headless_ok == 0) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_ok_failed";
    global_contract_conclusion = "Headless execution failed";
}

if (global_algorithm_executed == 0) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_not_executed";
    global_contract_conclusion = "FindCircle algorithm not executed";
}

if (global_budget_exceeded == 1) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_budget_exceeded";
    global_contract_conclusion = "FindCircle budget exceeded";
}

if (global_valid_points_count < 3) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_ok_failed";
    global_contract_conclusion = "FindCircle OK requires valid_points_count >= 3";
}

if (global_has_fit_circle == 0) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_ok_failed";
    global_contract_conclusion = "FindCircle OK requires has_fit_circle == true";
}

if (global_circle_radius <= 0) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_ok_failed";
    global_contract_conclusion = "FindCircle OK requires circle_radius > 0";
}

if (global_avgdist > 8.0) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_high_residual";
    global_contract_conclusion = "FindCircle OK requires avgdist <= 8.0";
}

if (global_rendered_measure_points_count < 1) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_points_not_rendered";
    global_contract_conclusion = "FindCircle measure points not rendered";
}

if (global_rendered_result_count < 1) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_fit_not_rendered";
    global_contract_conclusion = "FindCircle fit result not rendered";
}

if (global_result_overlay_changed_pixels < 32) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_overlay_empty";
    global_contract_conclusion = "FindCircle overlay has insufficient changed pixels";
}

if (global_policy_guard_match == 0) {
    global_contract_pass = 0;
    global_contract_status = "findcircle_ok_failed";
    global_contract_conclusion = "FindCircle OK requires CIRCLE_MEASURE_AND_FIT_AVAILABLE";
}

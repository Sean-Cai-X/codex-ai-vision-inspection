// WARNING: This is a Stage25 test template.
// Stage25Filter20 (filter_profile=1) is NOT the product default.
// Product default remains LegacyDefault (filter_profile=0, effective_filter_min=50).
//
// stage25_case_id: {{case_id}}
// image_id: {{image_id}}
// target_id: {{target_id}}
// profile_id: {{profile_id}}
// parameter_policy_id: {{parameter_policy_id}}
// parameter_role: {{parameter_role}}
// is_product_default: {{is_product_default}}
// roi: {{x0}},{{y0}} -> {{x1}},{{y1}}
// wgap/hgap: {{wgap}},{{hgap}}
// tool_half_width: {{tool_half_width}}
// method/threshold/linegap/filter_profile: {{method}},{{threshold}},{{linegap}},{{filter_profile}}

Image m_image;
FindLine m_line;

m_image.copyFromMat(global_matInput);

int x0 = {{x0}};
int y0 = {{y0}};
int x1 = {{x1}};
int y1 = {{y1}};

int method = {{method}};
int threshold = {{threshold}};
int linegap = {{linegap}};
int fitmode = {{fitmode}};

int wgap = {{wgap}};
int hgap = {{hgap}};
int script_scale = {{script_scale}};
int tool_half_width = {{tool_half_width}};

int filter_profile = {{filter_profile}};
int scan_direction = global_findline_scan_direction;

m_line.SetWHgap(wgap, hgap);
m_line.setline(x0, y0, x1, y1, tool_half_width);

m_line.setmethod(method);
m_line.setthre(threshold);
m_line.setlinegap(linegap);
m_line.setfitmode(fitmode);
m_line.setscandirection(scan_direction);

{{optional_findline_filter}}

if (filter_profile == 1)
{
    m_line.setfilterprofile(filter_profile);
    m_line.setobjfilter(1);
    m_line.setfilter(21, 20, 100000);
}
else
{
    m_line.setfilterprofile(filter_profile);
}

{{optional_findline_gamma}}

m_line.measure(&m_image);
m_line.fitline();

global_line_ref = m_line.get_result();
global_current_status = "PENDING";

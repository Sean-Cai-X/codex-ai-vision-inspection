Image m_image;
FindLine m_line;

m_image.copyFromMat(global_matInput);

m_line.setmaxelapsedms(global_max_elapsed_ms);
m_line.setmaxscanlines(global_max_scan_lines);
m_line.setmaxsamples(global_max_samples);

int x0 = global_roi_x0;
int y0 = global_roi_y0;
int x1 = global_roi_x1;
int y1 = global_roi_y1;

int tool_half_width = global_tool_half_width;

int strategy_id = global_strategy_id;
int selected_method = global_method;
int selected_threshold = global_threshold;
int selected_wgap = global_wgap;
int selected_hgap = global_hgap;
int selected_linegap = global_linegap;
int selected_filterprofile = global_filterprofile;

if (strategy_id == 10)
{
selected_wgap = 5;
selected_hgap = 20;
selected_linegap = 6;
selected_threshold = 30;
selected_method = 0;
selected_filterprofile = 0;
}

if (strategy_id == 11)
{
selected_wgap = 5;
selected_hgap = 20;
selected_linegap = 6;
selected_threshold = 30;
selected_method = 1;
selected_filterprofile = 0;
}

if (strategy_id == 20)
{
selected_wgap = 11;
selected_hgap = 32;
selected_linegap = 3;
selected_threshold = 20;
selected_method = 0;
selected_filterprofile = 1;
}

if (strategy_id == 21)
{
selected_wgap = 11;
selected_hgap = 32;
selected_linegap = 3;
selected_threshold = 20;
selected_method = 1;
selected_filterprofile = 1;
}

if (strategy_id == 30)
{
selected_wgap = 8;
selected_hgap = 20;
selected_linegap = 6;
selected_threshold = 10;
selected_method = 0;
selected_filterprofile = 1;
}

if (strategy_id == 31)
{
selected_wgap = 8;
selected_hgap = 20;
selected_linegap = 6;
selected_threshold = 10;
selected_method = 1;
selected_filterprofile = 1;
}

if (strategy_id == 40)
{
selected_wgap = 32;
selected_hgap = 8;
selected_linegap = 6;
selected_threshold = 20;
selected_method = 2;
selected_filterprofile = 1;
}

global_selected_method = selected_method;
global_selected_threshold = selected_threshold;
global_selected_wgap = selected_wgap;
global_selected_hgap = selected_hgap;
global_selected_linegap = selected_linegap;
global_selected_filterprofile = selected_filterprofile;

m_line.SetWHgap(selected_wgap, selected_hgap);
m_line.setlinegap(selected_linegap);
m_line.setline(x0, y0, x1, y1, tool_half_width);
m_line.setmethod(selected_method);
m_line.setthre(selected_threshold);
m_line.setfilterprofile(selected_filterprofile);
m_line.setscandirection(global_findline_scan_direction);
m_line.setselectedgenum(global_findline_selected_edge);

m_line.measure(&m_image);
m_line.fitline();

global_line_ref = m_line.get_result();

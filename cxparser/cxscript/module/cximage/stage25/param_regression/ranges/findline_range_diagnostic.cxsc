// Stage25 Parameter Regression Range: FindLine Diagnostic
// Wider diagnostic range. Candidates are not promoted without human review.

ParamRegressionTask_reset(0);
ParamRangeSet_reset(0);
ParamRangeSet_settool("FindLine");
ParamRangeSet_setid("findline_diagnostic_range");
ParamRangeSet_setmaxcandidates(24);
ParamRangeSet_setmaxcaseseconds(10);
ParamRangeSet_setmaxtotalseconds(120);

ParamRange_add("threshold");
ParamRange_setvalues("6,8,12,20,30,45");
ParamRange_setrole("formal");

ParamRange_add("linegap");
ParamRange_setvalues("2,4,6,10,14,20");
ParamRange_setrole("formal");

ParamRange_add("wgap");
ParamRange_setvalues("2,4,8,12,16");
ParamRange_setrole("diagnostic");

ParamRange_add("hgap");
ParamRange_setvalues("16,24,32,48,64");
ParamRange_setrole("diagnostic");

ParamRange_add("filterprofile");
ParamRange_setvalues("0,1,2");
ParamRange_setrole("diagnostic");

ParamRange_add("method");
ParamRange_setvalues("0,1,2");
ParamRange_setrole("diagnostic");

ParamRange_add("samplerate");
ParamRange_setvalues("1,2,4");
ParamRange_setrole("diagnostic");

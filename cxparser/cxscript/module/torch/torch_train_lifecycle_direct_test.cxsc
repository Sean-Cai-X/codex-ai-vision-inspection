Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

int timeout_ms = 30000;

m_task.settask("torch.train.segmentation.lifecycle_smoke.v1");
m_task.setrequestcontext(global_torch_request_context);
m_task.setmanifest("cxparser/cxscript/module/cximage/evidence/torch_runtime_ui_evidence_chain.cxsc");
m_task.setdevice("cpu");
m_task.settimeout(timeout_ms);

m_task.run(m_image);

global_headless_ok = m_task.getok();
global_torch_ok = m_task.getok();

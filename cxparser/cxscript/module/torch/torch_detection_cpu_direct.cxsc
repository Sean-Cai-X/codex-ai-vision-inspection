Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

m_task.settask("torch.infer.detection.yolov8.v1");
m_task.setcase("T_torch_detection_cpu");
m_task.setmanifest("libtorch_module/models/yolov8_defect_v1/model_manifest.json");
m_task.setinputpath("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/test_images/L1_high_contrast/line_high_contrast_001.jpg");
m_task.setoutputdir("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/cxscript_runs/headless/T6_torch_detection_cpu");
m_task.setdevice("cpu");
m_task.settimeout(30000);

m_task.run(m_image);

global_headless_ok = m_task.getok();
global_torch_ok = m_task.getok();
global_torch_result_count = m_task.getresultcount();
global_torch_infer_ms = m_task.getinferms();

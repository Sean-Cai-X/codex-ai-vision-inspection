Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

m_task.settask("torch.infer.segmentation.deeplabv3plus.v1");
m_task.setrequestcontext(global_torch_request_context);
m_task.setmanifest("libtorch_module/testdata/manifests/deeplab_cpp_state_dict_smoke_v1.json");
m_task.setdevice("cpu");
m_task.settimeout(30000);

m_task.run(m_image);

global_headless_ok = m_task.getok();
global_torch_ok = m_task.getok();
global_torch_mask_available = m_task.getmaskavailable();
global_torch_infer_ms = m_task.getinferms();

Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

int timeout_ms = 30000;

m_task.settask("torch.reference.hd.detection.oriented_screws.v1");
m_task.setcase("hd_screws_oriented_detection_reference");
m_task.setmodel("D:/HD/projects/Example_ObjDetection_Oriented_Screws.dltp");
m_task.setinputpath("D:/Codex-WorkDir/Sean_WorkDir/images/screws/screws_001.png");
m_task.setoutputdir("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/cxscript_runs/hd_reference/screws_oriented_detection");
m_task.setdevice("cpu");
m_task.settimeout(timeout_ms);

m_task.run(&m_image);

global_headless_ok = m_task.getok();
global_torch_ok = m_task.getok();
global_torch_detection_count = m_task.getresultcount();
global_torch_infer_ms = m_task.getinferms();


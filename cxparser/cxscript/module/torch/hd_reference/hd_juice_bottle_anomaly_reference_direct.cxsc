Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

int timeout_ms = 30000;

m_task.settask("torch.reference.hd.classification.anomaly_juice_bottle.v1");
m_task.setcase("hd_juice_bottle_anomaly_reference");
m_task.setmodel("D:/HD/projects/Example_AnomalyDet_JuiceBottle/Example Training/best_model.hdl");
m_task.setmanifest("D:/HD/projects/Example_AnomalyDet_JuiceBottle.dltp");
m_task.setinputpath("D:/Codex-WorkDir/Sean_WorkDir/images/juice_bottle/good/juice_bottle_good_001.png");
m_task.setoutputdir("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/cxscript_runs/hd_reference/juice_bottle_anomaly");
m_task.setdevice("cpu");
m_task.settimeout(timeout_ms);

m_task.run(&m_image);

global_headless_ok = m_task.getok();
global_torch_ok = m_task.getok();
global_torch_infer_ms = m_task.getinferms();


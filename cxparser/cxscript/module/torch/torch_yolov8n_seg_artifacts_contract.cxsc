global_contract_pass = 1;
global_contract_status = "yolov8n_seg_artifacts_ready";
global_contract_conclusion = "YOLOv8n-Seg runtime produced instance evidence for human review.";

if (global_headless_ok == 0) {
    global_contract_pass = 0;
    global_contract_status = "yolov8n_seg_headless_failed";
    global_contract_conclusion = "Headless execution failed";
}

if (global_algorithm_executed == 0) {
    global_contract_pass = 0;
    global_contract_status = "yolov8n_seg_not_executed";
    global_contract_conclusion = "YOLOv8n-Seg was not executed";
}

if (global_budget_exceeded == 1) {
    global_contract_pass = 0;
    global_contract_status = "yolov8n_seg_budget_exceeded";
    global_contract_conclusion = "YOLOv8n-Seg exceeded the execution budget";
}

if (global_torch_ok == 0) {
    global_contract_pass = 0;
    global_contract_status = "yolov8n_seg_runtime_failed";
    global_contract_conclusion = "Torch runtime did not return success";
}

if (global_torch_result_count < 1) {
    global_contract_pass = 0;
    global_contract_status = "yolov8n_seg_no_instances";
    global_contract_conclusion = "YOLOv8n-Seg requires at least one projected instance";
}

if (global_rendered_result_count < 1) {
    global_contract_pass = 0;
    global_contract_status = "yolov8n_seg_not_rendered";
    global_contract_conclusion = "YOLOv8n-Seg instance geometry was not rendered";
}

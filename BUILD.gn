import("//build/config/deps.gni")
import("//build/config/cxvision_sources.gni")
group("default") {
  deps = [ ":gn_configuration" ]
}
group("gn_configuration") {
}

# Opt-in inventory target; the default target intentionally does not compile it.
source_set("cxvision_source_inventory") {
  sources = filter_exclude(cxvision_default_sources, [
    "cximage/CxFastMatchHarmonicAudit.cpp",
    "cxgeom/src/CxGeoSO2Harmonic.cpp",
    "cxgeom/src/CxGeoSO2StagedSearch.cpp",
    "cxgeom/src/CxGeoSO2ReferenceAsset.cpp",
  ]) + [
    "cximage/CxFastMatchHarmonicAudit.cpp",
    glad_root + "/src/gl.c",
  ]
  configs = [ "//build/config:common", "//build/config:platform" ]
}

# Linux/Windows application link target. Third-party binaries remain external
# inputs selected by GN args; this target contains source and build metadata only.
executable("cxvision_imgui_acceptance") {
  deps = [ ":cxvision_source_inventory", ":cxgeom_set_match_adapter" ]
  configs = [ "//build/config:common", "//build/config:platform" ]
  libs = [ "torch", "torch_cpu", "c10" ]
}
if (enable_libtorch_smoke) {
  executable("libtorch_minimal_smoke") {
    sources = [ "libtorch_module/torch_minimal_smoke.cpp" ]
    configs = [ "//build/config:common", "//build/config:platform" ]
    libs = [ "torch", "torch_cpu", "c10" ]
  }
}

# Pure P0 geometry contracts: no GUI/OpenCV/Torch dependencies.
config("geometric_set_platform") {
  cflags_cc = [ "-std=c++17" ]
  if (is_linux) {
    cflags = [ "--sysroot=" + codex_vision_sysroot ]
    ldflags = [ "--sysroot=" + codex_vision_sysroot ]
    if (codex_vision_cxx_runtime_dir != "") {
      lib_dirs = [ codex_vision_cxx_runtime_dir ]
      libs = [ ":libstdc++.so.6" ]
      ldflags += [ "-Wl,-rpath," + codex_vision_cxx_runtime_dir ]
    }
  }
}
static_library("cxgeom_geometric_set_matching") {
  sources = [
    "cxgeom/geometric_set_matching/validation.cpp",
    "cxgeom/geometric_set_matching/topology.cpp",
    "cxgeom/geometric_set_matching/pose_estimation.cpp",
    "cxgeom/geometric_set_matching/matching.cpp",
  ]
  configs = [ ":geometric_set_platform" ]
}
executable("geometric_set_contract_test") {
  sources = [ "tests/geometric_set_matching/contract_test.cpp" ]
  deps = [ ":cxgeom_geometric_set_matching" ]
  configs = [ ":geometric_set_platform" ]
}

executable("geometric_set_matching_test") {
  sources = [ "tests/geometric_set_matching/matching_test.cpp" ]
  deps = [ ":cxgeom_geometric_set_matching" ]
  configs = [ ":geometric_set_platform" ]
}


static_library("cxgeom_set_match_adapter") {
  sources = [
    "cximage/FindSetMatch.cpp",
    "cxgeom/src/CxGeoSO2Harmonic.cpp",
    "cxgeom/src/CxGeoSO2StagedSearch.cpp",
    "cxgeom/src/CxGeoSO2ReferenceAsset.cpp",
  ]
  include_dirs = [ "cxgeom/include" ]
  deps = [ ":cxgeom_geometric_set_matching" ]
  configs = [ ":geometric_set_platform" ]
}
executable("geometric_set_adapter_test") {
  sources = [ "tests/geometric_set_matching/adapter_test.cpp" ]
  deps = [ ":cxgeom_set_match_adapter" ]
  configs = [ ":geometric_set_platform" ]
}
executable("harmonic_staged_test") {
  sources = [ "tests/fastmatch_harmonic/native_staged_test.cpp" ]
  include_dirs = [ "cxgeom/include" ]
  deps = [ ":cxgeom_set_match_adapter" ]
  configs = [ ":geometric_set_platform" ]
}

# Opt-in polar audit core; not connected to production matching.
static_library("cxgeom_polar_discrete_harmonic") {
  sources = [ "cxgeom/polar_discrete_harmonic/encoding.cpp" ]
  sources += [ "cxgeom/polar_discrete_harmonic/matching.cpp" ]
  sources += [ "cxgeom/polar_discrete_harmonic/partial_assessment.cpp" ]
  sources += [ "cxgeom/polar_discrete_harmonic/partial_search.cpp" ]
  configs = [ ":geometric_set_platform" ]
}
executable("harmonic_polar_encoding_test") {

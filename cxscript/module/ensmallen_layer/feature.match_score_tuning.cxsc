scenario {
  prepare_ok = 0;
  action_ok = 0;
  check_ok = 0;
  report_text = "";

  sample_id = "template_match.template_scene | template_match.template_scene_rotated";
  image = "<resolved_by_cxparser>";
  template_image = "<resolved_by_cxparser>";
  roi_main = "<resolved_by_cxparser>";
  gt = "<resolved_by_cxparser>";
  params = "<resolved_by_cxparser>";
  replay_log_path = "replay_log.jsonl";
  rag_writeback_case = "feature.match_score_writeback";

  ResolveTuningCase();

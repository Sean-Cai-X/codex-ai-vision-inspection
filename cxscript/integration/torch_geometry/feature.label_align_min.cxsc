scenario {
  double prepare_ok=0;
  double action_ok=0;
  double check_ok=0;
  double label_ready=0;
  trace_id="trace.integration.torch_geometry.feature.label_align.001";
  image_path="data/train/sample_001.png";
  roi_id="roi_train";
  mask_id="mask_gt";
  boundary_id="boundary_gt";
  keypoints_id="keypoints_gt";
  expected_artifact_ref="torch_geometry_label_packet";
  prepare_ok=1;

  if (prepare_ok) {
    geom_export_roi(image_path,roi_id);
    geom_export_mask_label(image_path,roi_id,mask_id);
    geom_export_boundary_label(image_path,roi_id,boundary_id);
    geom_export_keypoints_label(image_path,roi_id,keypoints_id);
    geom_align_training_label(roi_id,mask_id,boundary_id,keypoints_id);
    geom_build_torch_label_packet(roi_id,"label_align_bundle");
    action_ok=1;
  }

  check {
    label_ready=geom_check_label_ready(roi_id,"label_align_bundle");
    check_ok=action_ok&&label_ready;
  }

  report {
    chain_status="torch_geometry_label_ready";
    artifact_ref=expected_artifact_ref;
    packet_ref="label_align_bundle";
    report_text="training labels aligned";
  }
}

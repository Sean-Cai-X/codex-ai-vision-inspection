scenario {
  double prepare_ok=0;
  double action_ok=0;
  double check_ok=0;
  double replay_ready=0;
  trace_id="trace.integration.torch_geometry.infer.replay.001";
  image_path="data/infer/sample_001.png";
  roi_id="roi_main";
  expected_artifact_ref="torch_geometry_alignment_packet";
  prepare_ok=1;

  if (prepare_ok) {
    geom_export_roi(image_path,roi_id);
    geom_export_line("line_main");
    geom_export_pointset("pointset_main");
    geom_align_input_prior(roi_id,"line_main","pointset_main");
    geom_build_torch_request(roi_id,"input_prior_bundle");
    geom_export_mask_label(image_path,roi_id,"mask_gt");
    geom_export_boundary_label(image_path,roi_id,"boundary_gt");
    geom_export_keypoints_label(image_path,roi_id,"keypoints_gt");
    geom_align_training_label(roi_id,"mask_gt","boundary_gt","keypoints_gt");
    geom_build_torch_label_packet(roi_id,"label_align_bundle");
    torch_run("input_prior_bundle","label_align_bundle","torch_result_main");
    geom_attach_result_to_roi(roi_id,"pred_class",0.95,"embedding_main");
    geom_attach_result_mask(roi_id,"mask_pred");
    geom_attach_result_boundary(roi_id,"boundary_pred");
    geom_attach_result_keypoints(roi_id,"keypoints_pred");
    geom_publish_attach_packet(roi_id);
    action_ok=1;
  }

  check {
    replay_ready=geom_check_attach_ready(roi_id);
    check_ok=action_ok&&replay_ready;
  }

  report {
    chain_status="torch_geometry_alignment_replay_ready";
    artifact_ref=expected_artifact_ref;
    packet_ref="torch_result_main";
    report_text="torch geometry replay flow ready";
  }
}

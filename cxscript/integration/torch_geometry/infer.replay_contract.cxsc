double replay_contract_ok=0;
geom_export_roi(image_path,roi_id);
geom_export_line(line_id);
geom_export_pointset(pointset_id);
geom_align_input_prior(roi_id,line_id,pointset_id);
geom_build_torch_request(roi_id,input_prior_bundle);
geom_export_mask_label(image_path,roi_id,mask_id);
geom_export_boundary_label(image_path,roi_id,boundary_id);
geom_export_keypoints_label(image_path,roi_id,keypoints_id);
geom_align_training_label(roi_id,mask_id,boundary_id,keypoints_id);
geom_build_torch_label_packet(roi_id,label_align_bundle);
geom_attach_result_to_roi(roi_id,pred_class,pred_score,embedding_main);
geom_attach_result_mask(roi_id,mask_id);
geom_attach_result_boundary(roi_id,boundary_id);
geom_attach_result_keypoints(roi_id,keypoints_id);
geom_publish_attach_packet(roi_id);
replay_contract_ok=geom_check_replay_ready(roi_id);
replay_contract_ok;
